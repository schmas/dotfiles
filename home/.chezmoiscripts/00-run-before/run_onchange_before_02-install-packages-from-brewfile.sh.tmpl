#!/usr/bin/env bash
{{ if ne .chezmoi.os "darwin" }}
# Linux uses the linux-system-setup script instead
exit 0
{{ end }}

# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -e
set -u
set -o pipefail

echo ""
echo "-----------------------------------------------------------------------"
echo " Install Packages from Brewfile"
echo "-----------------------------------------------------------------------"
echo ""

{{ template "brew-shellenv" . }}

if ! command -v brew &> /dev/null; then
  echo "Error: Homebrew not found"
  exit 1
fi

# Brewfile location (use source dir since this runs before files are deployed)
BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"

if [[ ! -f "$BREWFILE" ]]; then
  echo "Warning: Brewfile not found at $BREWFILE"
  echo "Skipping package installation"
  exit 0
fi

echo "Installing packages from Brewfile..."

# Ask for sudo password once upfront and keep the session alive
# so cask installs don't repeatedly prompt
if sudo --validate 2>/dev/null; then
  # Refresh sudo timestamp in the background until this script exits
  while true; do sudo --non-interactive --validate; sleep 30; done &
  SUDO_REFRESH_PID=$!
  trap 'kill "$SUDO_REFRESH_PID" 2>/dev/null' EXIT INT TERM
fi

# Install taps first so brew bundle can resolve all formulae
grep '^tap ' "$BREWFILE" | while read -r _ tap_name; do
  tap_name="${tap_name%\"}"
  tap_name="${tap_name#\"}"
  if ! brew tap | grep -q "^${tap_name}$"; then
    echo "Tapping $tap_name..."
    brew tap "$tap_name"
  fi
done

brew bundle --file="$BREWFILE"

echo "Packages installed successfully!"
