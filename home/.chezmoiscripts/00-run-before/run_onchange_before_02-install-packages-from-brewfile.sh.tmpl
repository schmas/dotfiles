#!/usr/bin/env bash
{{ if ne .chezmoi.os "darwin" }}
# Linux uses the linux-system-setup script instead
exit 0
{{ end }}

# Brewfile hash: {{ include "dot_config/etc/Brewfile.tmpl" | sha256sum }}
# (raw source hash, just to retrigger this run_onchange script on edits —
# the actual Brewfile content used below comes from `chezmoi cat`, not this)

set -e
set -u
set -o pipefail

echo ""
echo "-----------------------------------------------------------------------"
echo " Install Packages from Brewfile"
echo "-----------------------------------------------------------------------"
echo ""

{{ template "brew-shellenv" . }}

if ! command -v brew &> /dev/null; then
  echo "Error: Homebrew not found"
  exit 1
fi

echo "Installing packages from Brewfile..."

# Rendered fresh via `chezmoi cat` (not read from the deployed file) so this
# run always uses current source state. The deployed file is a regular
# managed target, written only after this run_before script finishes, so
# reading it here would race a stale copy on the same apply that edited
# Brewfile.tmpl.
BREWFILE="$(mktemp)"
chezmoi cat ~/.config/etc/Brewfile > "$BREWFILE"

SUDO_REFRESH_PID=""
cleanup() {
  rm -f "$BREWFILE"
  [[ -n "$SUDO_REFRESH_PID" ]] && kill "$SUDO_REFRESH_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Ask for sudo password once upfront and keep the session alive
# so cask installs don't repeatedly prompt
if sudo --validate 2>/dev/null; then
  # Refresh sudo timestamp in the background until this script exits. The
  # `|| true` keeps the loop alive under `set -e` if a refresh ever fails.
  while true; do sudo --non-interactive --validate || true; sleep 30; done &
  SUDO_REFRESH_PID=$!
fi

# Install + trust taps first so brew bundle can resolve all formulae
{{ template "brew-trust-taps" . }}

brew bundle --file="$BREWFILE"

echo "Packages installed successfully!"
