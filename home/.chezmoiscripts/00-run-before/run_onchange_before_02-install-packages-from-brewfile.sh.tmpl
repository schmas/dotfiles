#!/usr/bin/env bash
{{ if ne .chezmoi.os "darwin" }}
# Linux uses the linux-system-setup script instead
exit 0
{{ end }}

# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -e
set -u
set -o pipefail

echo ""
echo "-----------------------------------------------------------------------"
echo " Install Packages from Brewfile"
echo "-----------------------------------------------------------------------"
echo ""

{{ template "brew-shellenv" . }}

if ! command -v brew &> /dev/null; then
  echo "Error: Homebrew not found"
  exit 1
fi

# Brewfile location (use source dir since this runs before files are deployed)
BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"

if [[ ! -f "$BREWFILE" ]]; then
  echo "Warning: Brewfile not found at $BREWFILE"
  echo "Skipping package installation"
  exit 0
fi

echo "Installing packages from Brewfile..."

# Ask for sudo password once upfront and keep the session alive
# so cask installs don't repeatedly prompt
if sudo --validate 2>/dev/null; then
  # Refresh sudo timestamp in the background until this script exits. The inner
  # `|| true` keeps the loop alive under `set -e` if a refresh ever fails, and
  # the trap's `|| true` stops a kill of an already-dead PID from becoming the
  # script's exit status (bash propagates the EXIT trap's last command status).
  while true; do sudo --non-interactive --validate || true; sleep 30; done &
  SUDO_REFRESH_PID=$!
  trap 'kill "$SUDO_REFRESH_PID" 2>/dev/null || true' EXIT INT TERM
fi

# Install + trust taps first so brew bundle can resolve all formulae
{{ template "brew-trust-taps" . }}

brew bundle --file="$BREWFILE"

echo "Packages installed successfully!"
