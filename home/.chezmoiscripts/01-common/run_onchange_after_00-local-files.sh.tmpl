#!/usr/bin/env bash

set -e
set -u
set -o pipefail

echo ""
echo "-----------------------------------------------------------------------"
echo " Create Local Configuration Files"
echo "-----------------------------------------------------------------------"
echo ""

CREATED=0
MERGE_MARKER="# chezmoi:merged"

# One-time merge: append template content to existing gpg-agent.conf and ssh_config
if [ -f ~/.gnupg/gpg-agent.conf ] && [ -f ~/.config/etc/gpg-agent.conf.template ]; then
  if ! grep -qF "$MERGE_MARKER" ~/.gnupg/gpg-agent.conf; then
    echo "Merging template into ~/.gnupg/gpg-agent.conf"
    printf '\n%s\n' "$MERGE_MARKER" >> ~/.gnupg/gpg-agent.conf
    cat ~/.config/etc/gpg-agent.conf.template >> ~/.gnupg/gpg-agent.conf
    chmod 600 ~/.gnupg/gpg-agent.conf
    CREATED=1
  fi
fi

if [ -f ~/.ssh/config ] && [ -f ~/.config/etc/ssh_config.template ]; then
  if ! grep -qF "$MERGE_MARKER" ~/.ssh/config; then
    echo "Merging template into ~/.ssh/config"
    printf '\n%s\n' "$MERGE_MARKER" >> ~/.ssh/config
    cat ~/.config/etc/ssh_config.template >> ~/.ssh/config
    chmod 600 ~/.ssh/config
    CREATED=1
  fi
fi

# Create main configuration files if they do not exist
if [ ! -f ~/.config/git/config ]; then
  echo "Creating ~/.config/git/config"
  cp ~/.config/etc/gitconfig.template ~/.config/git/config
  CREATED=1
fi

# SSH config section
if [ ! -d ~/.ssh ]; then
  echo "Creating ~/.ssh directory"
  mkdir -p ~/.ssh
  chmod 700 ~/.ssh
  CREATED=1
fi

if [ ! -f ~/.ssh/config ]; then
  echo "Creating ~/.ssh/config"
  cp ~/.config/etc/ssh_config.template ~/.ssh/config
  echo "$MERGE_MARKER" >> ~/.ssh/config
  chmod 600 ~/.ssh/config
  CREATED=1
fi

# >>> ssh_top_include >>>
# ssh_top_include <file> <line> <comment>: put <line> once above the first Host
# or Match block of <file>, with <comment> above it. An Include inside a block
# applies only to that block, and the one-time merge above appends the template
# below the user's own blocks. A copy found lower down is moved up, and a line
# equal to <comment> is removed there. Return 0 if the file changed, else 1.
ssh_top_include() {
  local file="$1" want="$2" comment="$3" tmp
  tmp=$(mktemp)
  awk -v want="$want" -v comment="$comment" '
    { l[NR] = $0 }
    END {
      h = NR + 1
      for (i = 1; i <= NR; i++)
        if (tolower(l[i]) ~ /^[ \t]*(host|match)([ \t=]|$)/) { h = i; break }
      for (i = 1; i < h; i++)
        if (l[i] == want) { for (k = 1; k <= NR; k++) print l[k]; exit }
      # Insert above the comment lines directly above the first block.
      p = h
      while (p > 1 && l[p - 1] ~ /^[ \t]*#/) p--
      for (i = 1; i < p; i++) print l[i]
      print comment
      print want
      print ""
      for (i = p; i <= NR; i++) {
        if (l[i] == want || l[i] == comment) {
          if (l[i] == want && l[i + 1] == "") i++
          continue
        }
        print l[i]
      }
    }' "$file" >"$tmp"
  if cmp -s "$file" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  cat "$tmp" >"$file"
  rm -f "$tmp"
  chmod 600 "$file"
}
# ssh_drop_include <file> <line>: remove <line>, the comment lines directly
# above it and one blank line after it. Return 0 if the file changed, else 1.
ssh_drop_include() {
  local file="$1" want="$2" tmp
  tmp=$(mktemp)
  awk -v want="$want" '
    { l[NR] = $0 }
    END {
      n = 0
      for (i = 1; i <= NR; i++) {
        if (l[i] == want) {
          while (n > 0 && out[n] ~ /^[ \t]*#/) n--
          if (l[i + 1] == "") i++
          continue
        }
        out[++n] = l[i]
      }
      for (i = 1; i <= n; i++) print out[i]
    }' "$file" >"$tmp"
  if cmp -s "$file" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  cat "$tmp" >"$file"
  rm -f "$tmp"
  chmod 600 "$file"
}
# ssh_replace_line <file> <old> <new>: replace every line equal to <old> with
# <new>. Return 0 if the file changed, else 1.
ssh_replace_line() {
  local file="$1" old="$2" new="$3" tmp
  tmp=$(mktemp)
  awk -v old="$old" -v new="$new" '{ print ($0 == old ? new : $0) }' "$file" >"$tmp"
  if cmp -s "$file" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  cat "$tmp" >"$file"
  rm -f "$tmp"
  chmod 600 "$file"
}
# <<< ssh_top_include <<<

# Host drop-ins live in ~/.ssh/config.d/: 00-machine (this machine's key,
# written by chezmoi) and the pack files. ssh reads them in name order and
# keeps the first value it reads, so the Include goes above every Host block.
if [ ! -d ~/.ssh/config.d ]; then
  mkdir -p ~/.ssh/config.d
  chmod 700 ~/.ssh/config.d
fi
if ssh_top_include ~/.ssh/config "Include ~/.ssh/config.d/*" \
  "# Host drop-ins: 00-machine (this machine's key), then pack files. Keep this above every Host block."; then
  echo "Moved the config.d Include above every Host block in ~/.ssh/config"
  CREATED=1
fi
if ssh_replace_line ~/.ssh/config \
  "# Hosts from packs (private chezmoi instances). Keep this above every Host block." \
  "# Host drop-ins: 00-machine (this machine's key), then pack files. Keep this above every Host block."; then
  echo "Updated the config.d Include comment in ~/.ssh/config"
  CREATED=1
fi
# The machine key hosts moved from ~/.ssh/agent_config to config.d/00-machine.
if ssh_drop_include ~/.ssh/config "Include ~/.ssh/agent_config"; then
  echo "Removed the old agent_config Include from ~/.ssh/config"
  CREATED=1
fi

# GnuPG section
if [ ! -d ~/.gnupg ]; then
  echo "Creating ~/.gnupg directory"
  mkdir -p ~/.gnupg
  chmod 700 ~/.gnupg
  CREATED=1
fi

if [ ! -f ~/.gnupg/gpg-agent.conf ]; then
  echo "Creating ~/.gnupg/gpg-agent.conf"
  cp ~/.config/etc/gpg-agent.conf.template ~/.gnupg/gpg-agent.conf
  echo "$MERGE_MARKER" >> ~/.gnupg/gpg-agent.conf
  chmod 600 ~/.gnupg/gpg-agent.conf
  CREATED=1
fi

if [ ! -f ~/.npmrc ]; then
  if [ -f ~/.config/etc/npmrc.template ]; then
    echo "Creating ~/.npmrc from template"
    cp ~/.config/etc/npmrc.template ~/.npmrc
    CREATED=1
  fi
fi

if [ ! -f ~/.config/fish/config_local.fish ]; then
  echo "Creating ~/.config/fish/config_local.fish"
  cp ~/.config/fish/config_local.template.fish ~/.config/fish/config_local.fish
  CREATED=1
fi

if [ ! -f ~/.config/bash/bashrc_local ]; then
  echo "Creating ~/.config/bash/bashrc_local"
  cp ~/.config/bash/bashrc_local.template ~/.config/bash/bashrc_local
  CREATED=1
fi

if [ ! -f ~/.config/zsh/zshrc_local ]; then
  echo "Creating ~/.config/zsh/zshrc_local"
  cp ~/.config/zsh/zshrc_local.template ~/.config/zsh/zshrc_local
  CREATED=1
fi

{{- if eq .chezmoi.os "darwin" }}
if [ ! -f /Library/LaunchDaemons/limit.maxfiles.plist ]; then
  echo "Creating /Library/LaunchDaemons/limit.maxfiles.plist"
  sudo cp ~/.config/etc/limit.maxfiles.plist /Library/LaunchDaemons/limit.maxfiles.plist
  sudo chmod 644 /Library/LaunchDaemons/limit.maxfiles.plist
  CREATED=1
fi
{{- end }}

if [ "$CREATED" -eq 0 ]; then
  echo "All local configuration files already exist."
fi
