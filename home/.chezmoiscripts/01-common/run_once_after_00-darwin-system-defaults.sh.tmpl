#!/usr/bin/env bash
{{ if ne .chezmoi.os "darwin" }}
# Skip on non-macOS systems
exit 0
{{ end }}

set -e

# Apply consolidated macOS defaults
if command -v setup-macos-defaults &> /dev/null; then
  setup-macos-defaults
elif [[ -x "$HOME/bin/macos/setup-macos-defaults" ]]; then
  "$HOME/bin/macos/setup-macos-defaults"
else
  echo "Warning: setup-macos-defaults not found, skipping system defaults"
fi

# =============================================================================
# Dock Items (requires dockutil)
# =============================================================================

if command -v dockutil &> /dev/null; then
  echo "Configuring Dock items..."

  # Remove all items first
  dockutil --no-restart --remove all

  # Add apps
  dockutil --no-restart --add "/System/Applications/System Settings.app"
  dockutil --no-restart --add "/System/Applications/Launchpad.app"
  dockutil --no-restart --add "/System/Applications/Reminders.app"
  dockutil --no-restart --add "/Applications/Ghostty.app"

  # Add Downloads folder
  dockutil --no-restart --add "$HOME/Downloads" --section others --view list --display folder --sort dateadded

  # Restart Dock for dockutil changes
  killall Dock 2>/dev/null || true
fi
