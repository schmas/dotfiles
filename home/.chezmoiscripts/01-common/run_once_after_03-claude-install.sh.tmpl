#!/usr/bin/env bash
set -e
set -u
set -o pipefail

echo ""
echo "-----------------------------------------------------------------------"
echo " Setup Claude Code CLI"
echo "-----------------------------------------------------------------------"
echo ""

# Delegate entirely to standalone script (DRY - single source of truth)
# It clones the config repo first, then installs the CLI
SETUP_SCRIPT="${HOME}/bin/setup-claude-code"
if [ -x "$SETUP_SCRIPT" ]; then
  exec "$SETUP_SCRIPT"
else
  echo "Note: setup-claude-code not found, skipping config setup"
  echo "Run 'chezmoi apply' to install bin scripts first"
fi
