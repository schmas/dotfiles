#!/usr/bin/env bash
# Brewfile hash: {{ include "Brewfile.tmpl" | sha256sum }}
{{ if eq .chezmoi.os "darwin" }}
# Skip on macOS
exit 0
{{ end }}

set -e
set -u
set -o pipefail

echo ""
echo "-----------------------------------------------------------------------"
echo " Linux System Setup"
echo "-----------------------------------------------------------------------"
echo ""

# =============================================================================
# Detect package manager
# =============================================================================

if command -v apt &> /dev/null; then
  PKG_MGR="apt"
  INSTALL="sudo apt install -y"
  UPDATE="sudo apt update"
elif command -v dnf &> /dev/null; then
  PKG_MGR="dnf"
  INSTALL="sudo dnf install -y"
  UPDATE="sudo dnf check-update || true"
elif command -v pacman &> /dev/null; then
  PKG_MGR="pacman"
  INSTALL="sudo pacman -S --noconfirm"
  UPDATE="sudo pacman -Syu --noconfirm"
else
  echo "Unsupported package manager"
  exit 1
fi

echo "Detected package manager: $PKG_MGR"

# =============================================================================
# Install essential system packages
# =============================================================================

echo "Installing essential packages..."
$UPDATE

case $PKG_MGR in
  apt)
    $INSTALL \
      build-essential \
      curl \
      wget \
      git \
      fish \
      procps \
      file
    ;;
  dnf)
    $INSTALL \
      @development-tools \
      curl \
      wget \
      git \
      fish \
      procps-ng \
      file
    ;;
  pacman)
    $INSTALL \
      base-devel \
      curl \
      wget \
      git \
      fish \
      procps-ng \
      file
    ;;
esac

# =============================================================================
# Set fish as default shell
# =============================================================================

FISH_PATH=$(command -v fish || true)
if [[ -n "$FISH_PATH" ]]; then
  if ! grep -q "$FISH_PATH" /etc/shells; then
    echo "Adding fish to /etc/shells..."
    echo "$FISH_PATH" | sudo tee -a /etc/shells
  fi

  # Compare against the real login shell (getent); $SHELL is stale in non-login
  # shells such as SSH sessions, which makes this re-run every time. Use
  # `sudo chsh` so it doesn't prompt for the login password via PAM, and never
  # abort the setup if changing the shell fails.
  current_shell="$(getent passwd "$(id -un)" | cut -d: -f7)"
  if [[ "$current_shell" != "$FISH_PATH" ]]; then
    echo "Setting fish as default shell..."
    sudo chsh -s "$FISH_PATH" "$(id -un)" || echo "Warning: could not set fish as default shell; run 'chsh -s $FISH_PATH' manually. Continuing."
  fi
fi

# =============================================================================
# Install Homebrew (Linux)
# =============================================================================

if ! command -v brew &> /dev/null; then
  echo "Installing Homebrew for Linux..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Add to current session (check both possible paths)
  if [[ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  elif [[ -f "$HOME/.linuxbrew/bin/brew" ]]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
  fi
fi

# =============================================================================
# Install packages via Homebrew
# =============================================================================

BREWFILE="$HOME/Brewfile"
if [[ -f "$BREWFILE" ]]; then
  # Install + trust taps first so brew bundle can resolve all formulae
{{ template "brew-trust-taps" . }}

  echo "Installing packages from Brewfile..."
  # On Linux, casks/mas are auto-skipped and macOS-only formulae (mas,
  # dockutil, pinentry-mac, …) fail with "macOS is required". brew bundle
  # still installs everything else but exits non-zero, so don't let that
  # abort the whole setup.
  if ! brew bundle --file="$BREWFILE"; then
    echo "Note: some Brewfile entries failed — expected for macOS-only formulae on Linux. Continuing."
  fi
else
  echo "Warning: Brewfile not found at $BREWFILE"
fi

# =============================================================================
# WSL-specific setup
# =============================================================================

if grep -qi microsoft /proc/version 2>/dev/null; then
  echo "WSL detected, applying WSL-specific configuration..."

  # Create symlink to Windows home if it exists. cmd.exe is not on PATH in
  # non-login/SSH shells, so fall back to its full path and never let a failure
  # here abort the setup (the trailing `|| true` neutralises set -e/pipefail).
  win_cmd="$(command -v cmd.exe 2>/dev/null || echo /mnt/c/Windows/System32/cmd.exe)"
  win_user="$("$win_cmd" /c 'echo %USERNAME%' 2>/dev/null | tr -d '\r\n' || true)"
  if [[ -n "$win_user" && -d "/mnt/c/Users/$win_user" && ! -L "$HOME/winhome" ]]; then
    ln -sf "/mnt/c/Users/$win_user" "$HOME/winhome"
    echo "Created symlink: ~/winhome -> /mnt/c/Users/$win_user"
  fi

  # Configure Git to use Windows credential manager
  git config --global credential.helper "/mnt/c/Program\ Files/Git/mingw64/bin/git-credential-manager.exe" 2>/dev/null || true
fi

echo "Linux setup complete!"
