#!/usr/bin/env bash
{{ if ne .chezmoi.os "darwin" }}
# Skip on non-macOS systems
exit 0
{{ end }}

set -e

# Reload launchd agents
# Triggered when plists change:
#   atuin-dedup:     {{ include "private_Library/LaunchAgents/com.schmas.atuin-dedup.plist" | sha256sum }}

load_agent() {
  local plist="$1"
  local label="$2"
  local desc="$3"

  if [ ! -f "$plist" ]; then
    echo "Skipping $label: $plist not found"
    return
  fi

  echo "Loading $label launchd agent..."
  launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "$label agent loaded ($desc)"
}

load_agent "$HOME/Library/LaunchAgents/com.schmas.atuin-dedup.plist" \
  "atuin-dedup" "Mon & Thu 15:00"
