# This is an INI configuration file

# theme
theme = "GitHub Dark"
#theme = "Builtin Pastel Dark"
#theme = "Dark Pastel"
#window-theme = ghostty
macos-icon = official
#macos-icon = custom-style
#macos-icon-ghost-color = #BCBEC4
#macos-icon-screen-color = #00FF00
background-opacity = 0.99

# font
font-family = "MesloLGL Nerd Font Mono"
font-family = "JetBrainsMono Nerd Font Mono"
font-family = "GeistMono Nerd Font"
font-size = 16
font-feature = -liga
font-thicken = true

# cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# initial size
window-width = 130
window-height = 40

# updates
auto-update = download

# misc
confirm-close-surface = false
window-save-state = always
quit-after-last-window-closed = true

# macos
macos-option-as-alt = true

# scrollback
scrollback-limit = 10000000

# copy/paste
selection-clear-on-typing = true
selection-clear-on-copy = true
copy-on-select = clipboard
#clipboard-paste-protection = false

# window padding
window-padding-x = 8
window-padding-y = 4

# split styling
unfocused-split-opacity = 0.8
split-divider-color = #555555

# notify
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s


# keybinds
keybind = cmd+shift+v=paste_from_clipboard
keybind = cmd+k=clear_screen
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+[=goto_split:previous
keybind = cmd+]=goto_split:next
# keybind = cmd+shift+r=rename_tab  # Not a valid Ghostty action
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3

keybind = resize/arrow_up=resize_split:up,10
keybind = resize/arrow_down=resize_split:down,10
keybind = resize/arrow_left=resize_split:left,10
keybind = resize/arrow_right=resize_split:right,10
keybind = resize/escape=deactivate_key_table
keybind = resize/catch_all=ignore
keybind = cmd+shift+r=activate_key_table:resize
