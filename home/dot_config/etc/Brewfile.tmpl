# Brewfile - Declarative package management
# Run: brew bundle --file=~/Brewfile
# macOS-only entries are wrapped in OS conditionals — this file is a chezmoi template.

# ── Taps (cross-platform) ──────────────────────────────────────────────────
tap "gromgit/brewtils"
tap "dlvhdr/formulae"
tap "atlassian/homebrew-acli"
tap "neurosnap/tap"
tap "jandedobbeleer/oh-my-posh"
{{ if eq .chezmoi.os "darwin" }}
# ── Taps (macOS only) ─────────────────────────────────────────────────────
tap "slp/krunkit"
tap "nikolaeu/numi"
{{ end }}
# ── Shells ────────────────────────────────────────────────────────────────
brew "bash"           # Bash 5.x (newer than macOS default)
brew "fish"           # Friendly interactive shell
brew "zsh"            # Zsh (newer than macOS default)
brew "nushell"        # Modern shell

# ── Core Shell Tools ──────────────────────────────────────────────────────
brew "atuin"          # Shell history sync
brew "sheldon"        # Shell plugin manager
brew "starship"       # Cross-shell prompt
brew "jandedobbeleer/oh-my-posh/oh-my-posh"  # Prompt theme engine (source build, cross-platform)
brew "tmux"           # Terminal multiplexer
brew "herdr"          # Terminal multiplexer
brew "neurosnap/tap/zmx"  # tmux session manager (fuzzy switcher)
brew "gum"            # Glamorous shell script tool (charmbracelet)

# ── GNU Utilities ─────────────────────────────────────────────────────────
brew "coreutils"      # GNU core utilities
brew "moreutils"      # Additional Unix utilities
brew "findutils"      # GNU find, xargs, locate
brew "gnu-sed"        # GNU sed
brew "gnu-tar"        # GNU tar
brew "gawk"           # GNU awk
brew "watch"          # Execute program periodically

# ── File Tools ────────────────────────────────────────────────────────────
brew "bat"            # Cat with syntax highlighting
brew "dust"           # Modern du replacement
brew "eza"            # Modern ls replacement
brew "fd"             # Modern find replacement
brew "fzf"            # Fuzzy finder
brew "television"     # Fast fuzzy finder (tv)
brew "ripgrep"        # Fast grep replacement
brew "sd"             # Modern sed replacement
brew "tree-sitter"    # Parser generator
brew "sevenzip"       # 7-Zip archive tool
brew "unar"           # Universal archive extractor
brew "yazi"           # Terminal file manager
brew "zoxide"         # Smarter cd command
brew "fswatch"        # File change monitor

# ── Viewers ───────────────────────────────────────────────────────────────
brew "chafa"              # Terminal image viewer
brew "ffmpeg-full"        # Audio/video processing
brew "ffmpegthumbnailer"  # Video thumbnailer
brew "imagemagick-full"   # Image manipulation toolkit
brew "resvg"              # SVG rendering library
brew "poppler"            # PDF utilities
brew "viu"                # Terminal image viewer
brew "glow"               # Markdown renderer (charmbracelet)

# ── Data Processing ───────────────────────────────────────────────────────
brew "csvlens"        # CSV file viewer
brew "jq"             # JSON processor
brew "yq"             # YAML processor
brew "gettext"        # GNU gettext (includes envsubst)

# ── Editors ───────────────────────────────────────────────────────────────
brew "vim"
brew "neovim"

# ── Version Control ───────────────────────────────────────────────────────
brew "git"
brew "git-lfs"        # Large file storage
brew "worktrunk"      # Git worktree manager
brew "gitleaks"       # Secret scanner
brew "gh"             # GitHub CLI
brew "lazygit"        # Git TUI
brew "dlvhdr/formulae/diffnav"  # Diff navigator
brew "git-delta"      # Git diff viewer
brew "diff-so-fancy"  # Better git diffs
brew "difftastic"     # Structural diff

# ── Development ───────────────────────────────────────────────────────────
brew "jdtls"          # Java language server
brew "go"             # Go toolchain
brew "gopls"          # Go language server
brew "pyright"        # Python language server
brew "ast-grep"       # AST-based search
brew "just"           # Task runner
brew "luarocks"       # Lua package manager
brew "mise"           # Dev runtime manager (replaces asdf)
brew "pkg-config"     # Compiler helper
brew "tokei"          # Code statistics

# ── Database ──────────────────────────────────────────────────────────────
brew "libpq"          # PostgreSQL client (psql) without full server
brew "freetds"        # SQL Server / Sybase client library

# ── Containers ────────────────────────────────────────────────────────────
brew "gromgit/brewtils/taproom" # Homebrew tap browser
brew "docker"         # Docker CLI — drives remote daemon via SSH context
brew "docker-compose" # Compose v2 plugin

# ── Monitoring ────────────────────────────────────────────────────────────
brew "btop"           # Resource monitor
brew "fastfetch"      # System info (neofetch successor)
brew "procs"          # Modern ps replacement

# ── Networking ────────────────────────────────────────────────────────────
brew "curl"
brew "wget"
brew "inetutils", link: false # Network utilities (unlinked: gping binary conflicts with standalone gping)
brew "bind"           # DNS tools (dig)
brew "wishlist"       # SSH endpoint directory (charmbracelet)

# ── Security ──────────────────────────────────────────────────────────────
brew "openssl"
brew "gnupg"          # GPG
brew "sshpass"        # SSH password auth
brew "pinentry"       # GPG PIN entry

# ── Utilities ─────────────────────────────────────────────────────────────
brew "chezmoi"        # Dotfiles manager
brew "hyperfine"      # CLI benchmarking
brew "shfmt"          # Shell formatter
brew "xz"             # Compression
brew "urlview"        # URL extractor
brew "acli"           # Atlassian CLI
brew "skate"          # Personal key-value store (charmbracelet)
{{ if eq .chezmoi.os "darwin" }}
# ── macOS-only formulae ───────────────────────────────────────────────────
brew "pinentry-mac"                # macOS keychain PIN entry
brew "mas"                         # Mac App Store CLI
brew "mole"                        # macOS system cleaner (tw93/Mole)
brew "reattach-to-user-namespace"  # tmux clipboard fix
brew "pam-reattach"                # Touch ID in tmux
brew "dockutil"                    # Dock management
brew "krunkit"                     # Lightweight VM runtime (Virtualization.framework)
brew "nikolaeu/numi/numi-cli"      # Numi calculator CLI
brew "terminal-notifier"           # macOS notifications from scripts (aaa-watch-pipeline)

