_atlassian_cli_alias[bb]='bitbucket'

_atlassian_cli_node() {
    local node=$1 ret=1
    local -a specs
    [[ -z ${_atlassian_cli_own_opts[$node]} ]] && specs+=( $_atlassian_cli_global_opts )
    [[ -n ${_atlassian_cli_opts[$node]} ]] && specs+=( ${(f)_atlassian_cli_opts[$node]} )

    if [[ -z ${_atlassian_cli_subs[$node]} ]]; then
        _arguments -s -S $specs && ret=0
        return $ret
    fi

    local context curcontext=$curcontext state line
    typeset -A opt_args
    _arguments -s -C $specs '1: :->command' '*:: :->argument' && ret=0

    case $state in
        command)
            local -a subs
            subs=( ${(f)_atlassian_cli_subs[$node]} )
            _describe -t commands 'command' subs && ret=0
            ;;
        argument)
            local child
            if [[ $node == . ]]; then child=$words[1]; else child="$node/$words[1]"; fi
            child=${_atlassian_cli_alias[$child]:-$child}
            if (( ${+_atlassian_cli_subs[$child]} + ${+_atlassian_cli_opts[$child]} )); then
                curcontext="${curcontext%:*:*}:atlassian-cli-${child//\//-}:"
                _atlassian_cli_node "$child" && ret=0
            fi
            ;;
    esac
    return $ret
}

_atlassian-cli() {
    _atlassian_cli_node .
}

_atlassian-cli "$@"
