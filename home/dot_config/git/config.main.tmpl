{{- $agentKey := includeTemplate "agent-key-item" . | trim -}}
[user]
name = {{ onepasswordRead "op://dotfiles/dotfiles_data/git/name" }}
email = {{ onepasswordRead "op://dotfiles/dotfiles_data/git/email" }}
{{- if $agentKey }}
# Sign with this machine's agent key file (1Password vault "Agent", written by
# chezmoi). git's default signer, ssh-keygen, reads it with no approval prompt.
signingkey = {{ .chezmoi.homeDir }}/.ssh/id_agent
{{- else }}
signingkey = {{ onepasswordRead "op://Dotfiles/e7qsp6u5my2gxxaqsdkyas6dt4/public key" }}
{{- end }}

[gpg]
  format = ssh
{{- if $agentKey }}
[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
{{- end }}
{{- if .is_wsl }}
[core]
  # Bitbucket) keep ssh.exe and the Windows 1Password agent.
  sshCommand = {{ .chezmoi.homeDir }}/bin/git-ssh-wsl
{{- end }}

[commit]
  gpgsign = true
