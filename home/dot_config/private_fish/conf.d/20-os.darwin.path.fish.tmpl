# Homebrew coreutils gnubin (use GNU tools without 'g' prefix)
# Only add if directory exists
if test -d "/opt/homebrew/opt/coreutils/libexec/gnubin"
    fish_add_path --global --move --path "/opt/homebrew/opt/coreutils/libexec/gnubin"
end

# libpq (psql client without full PostgreSQL server)
if test -d "/opt/homebrew/opt/libpq/bin"
    fish_add_path --global --move --path "/opt/homebrew/opt/libpq/bin"
end

# Antigravity
if test -d "$HOME/.antigravity/antigravity/bin"
    fish_add_path --global --move --path "$HOME/.antigravity/antigravity/bin"
end

# openssl@1.1 for python #
