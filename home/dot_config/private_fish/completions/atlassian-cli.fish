function __atlassian_cli_resolve --description 'Resolve the subcommand path on the command line'
    set -l tokens (commandline -xpc)
    set -e tokens[1]
    set -l node ''
    for token in $tokens
        string match -q -- '-*' $token; and continue
        set -l candidate (string trim -- "$node $token")
        switch $candidate
            case 'bb'
                set candidate 'bitbucket'
        end
        if contains -- $candidate $__atlassian_cli_nodes
            set node $candidate
        end
    end
    echo $node
end

function __atlassian_cli_at --description 'Test the resolved subcommand path against the given paths'
    set -l line (commandline -xpc | string join \x1f)
    if test "$line" != "$__atlassian_cli_line"
        set -g __atlassian_cli_line $line
        set -g __atlassian_cli_node (__atlassian_cli_resolve)
    end
    contains -- "$__atlassian_cli_node" $argv
end

