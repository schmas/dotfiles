{{- /*
  chezmoi config template: `chezmoi init` renders it to
  ~/.config/chezmoi/chezmoi.yaml. It asks no questions; every value comes from
  the machine (OS, WSL). After a change here, run `chezmoi init` again.
  See https://www.chezmoi.io/docs/reference/#special-files-and-directories
*/ -}}

{{- /* os_id variable: i.e. linux-ubuntu */}}
{{- $os_id := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
  {{-   $os_id = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{- /* os_id_like variable: i.e. linux-ubuntu */}}
{{- $os_id_like := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "idLike" -}}
  {{- $idLikeList := splitList " " .chezmoi.osRelease.idLike -}}
  {{- $firstIdLike := index $idLikeList 0 -}}
  {{- $os_id_like = printf "%s-%s" .chezmoi.os $firstIdLike -}}
{{- end -}}

{{- /* WSL detection: linux kernel reporting "microsoft" */}}
{{- $is_wsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
    {{- $is_wsl = true -}}
  {{- end -}}
{{- end }}
data:
  os_id: {{ $os_id | quote }}
  os_id_like: {{ $os_id_like | quote }}
  # nix-config is deprecated; the using_nix branches stay until they are removed.
  using_nix: false
  is_wsl: {{ $is_wsl }}

edit:
  command: "nvim"
{{- if $is_wsl }}

# WSL: the Linux op binary cannot reach the Windows 1Password desktop app, so
# route secret reads through the op bridge (which calls op.exe via interop).
# prompt: false skips `op signin`: app integration needs no session, and the
# bridge cannot reach the app for the op call right after a signin.
onepassword:
  command: "{{ .chezmoi.homeDir }}/.local/bin/op"
  prompt: false
{{ end -}}
