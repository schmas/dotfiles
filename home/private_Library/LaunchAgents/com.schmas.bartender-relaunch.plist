<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.schmas.bartender-relaunch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>sleep 60; osascript -e 'tell application id "com.surteesstudios.Bartender" to quit'; sleep 3; open -b com.surteesstudios.Bartender</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
