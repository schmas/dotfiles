#!/usr/bin/env bash
# ak-update — refresh AgentKit (binary + global engineer kit) and reapply local
# customizations.
#
# Successor to ck-update. AgentKit split the old monolithic `ck init` into
# separate binary + kit operations, so this runs:
#   1. `ak self-update`                       — update the ak binary
#   2. `ak kit refresh engineer --global`      — refresh the global engineer kit
#   3. reapply date-first report naming        — kit refresh overwrites hooks
#   4. restore the custom statusline
#   5. fix script permissions
#   6. prune old kit snapshots       — only if this run created one
#
# The engineer kit is a paid remote kit: steps 1-2 need a valid `ak login`
# session. Shares the upall TUI/runner engine: standalone it shows a fixed
# status header + live logs; when invoked by `upall` (UPALL_ACTIVE=1) it runs
# plain and streams into upall's output.
#
# Usage: ak-update [--dry-run|-n]
#   --dry-run  Preview only — binary uses `--check`, kit refresh is echoed,
#              and local customizations are described but not written.

set -uo pipefail

# Newest kit snapshots to retain when pruning (~17M per update run).
BACKUP_KEEP_LAST=10
BACKUPS_DIR="$HOME/.agentkit/backups"
# Snapshot count taken before the kit step mutates anything. Empty means the kit
# step never ran, so step_prune has no evidence a snapshot was created.
BACKUPS_BEFORE=""

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) DRY_RUN=1 ;;
    -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "ak-update: unknown option: $arg (see --help)" >&2; exit 2 ;;
  esac
done

LIB="$HOME/bin/lib/upall-lib.sh"
[ -f "$LIB" ] || LIB="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lib/upall-lib.sh"
# shellcheck source=/dev/null
. "$LIB" || { echo "ak-update: cannot load $LIB" >&2; exit 3; }

set_title() { printf '\033]0;ak-update: %s\007' "$1"; }
dry_note()  { printf '  \033[2m(dry-run)\033[0m would run: %s\n' "$*"; }

count_backups() {
  [ -d "$BACKUPS_DIR" ] || { echo 0; return 0; }
  find "$BACKUPS_DIR" -maxdepth 1 -mindepth 1 -type d | wc -l | tr -d '[:space:]'
}

# ── Step implementations ──────────────────────────────────────────────────────
# shellcheck disable=SC2329  # step_* are dispatched indirectly via STEP_FNS[] (upall-lib.sh)
step_binary() {
  if [ "$DRY_RUN" = 1 ]; then
    ak self-update --check
  else
    ak self-update --yes
  fi
}

step_kit() {
  # Recorded before any mutation so step_prune can tell whether this run
  # actually produced a snapshot.
  BACKUPS_BEFORE=$(count_backups)

  if [ "$DRY_RUN" = 1 ]; then
    dry_note "ak kit refresh engineer --global --yes"
    # kit refresh has no dry-run flag; surface drift/integrity read-only instead.
    ak doctor --check kit_integrity --no-interactive
    return $?
  fi

  local out rc
  out=$(ak kit refresh engineer --global --yes 2>&1); rc=$?
  printf '%s\n' "$out"
  [ "$rc" -eq 0 ] && return 0

  # step_naming deliberately edits context-builder.cjs, an AgentKit-owned hook
  # runtime file. On a kit version bump the emitter will not preserve that one
  # modified file next to updated siblings (it would be a mixed-version hook
  # runtime) and aborts without writing. Recover with the force reinstall the
  # error itself prescribes; it snapshots first, and step_naming reapplies the
  # patch immediately afterwards.
  if [[ $out == *"mixed-version hook runtime"* ]]; then
    printf '  recovering: local hook patch blocked the refresh; force-reinstalling kit\n'
    ak kit init engineer --target claude-code --global --force --yes
    return $?
  fi

  return "$rc"
}

step_naming() {
  local script="$HOME/bin/ak-reapply-claude-naming"
  if [ "$DRY_RUN" = 1 ]; then
    dry_note "node $script (date-first report naming in context-builder.cjs)"
    return 0
  fi
  node "$script"
}

step_statusline() {
  local f="$HOME/.claude/settings.json"
  if [ "$DRY_RUN" = 1 ]; then
    dry_note "jq set .statusLine=ccstatusline (mise) in $f"
    return 0
  fi
  jq '.statusLine = {"type": "command", "command": "mise x npm:ccstatusline -- ccstatusline", "padding": 0, "refreshInterval": 60}' \
    "$f" > "$f.tmp" && mv "$f.tmp" "$f"
}

step_prune() {
  # Every refresh the emitter blocks over the local hook patch leaves snapshots
  # behind, so they accrue once per run. Keep a fixed number of the newest
  # rather than a time window, so the disk ceiling holds no matter how often
  # this runs. Runs last, so this run's own snapshots survive.
  #
  # Prune only when this run actually created a snapshot: with nothing new
  # added there is nothing to reclaim, and skipping keeps a read-only update
  # from deleting history as a side effect.
  if [ "$DRY_RUN" = 1 ]; then
    # A dry run never creates a snapshot, so the gate below would always skip.
    # Show the real plan instead — prune --dry-run only reads.
    ak backups prune --keep-last "$BACKUP_KEEP_LAST" --dry-run --no-interactive
    return $?
  fi

  if [ -z "$BACKUPS_BEFORE" ]; then
    printf '  kit step did not run; nothing to prune\n'
    return 0
  fi

  local after; after=$(count_backups)
  if [ "$after" -le "$BACKUPS_BEFORE" ]; then
    printf '  no new snapshot this run (%s); nothing to prune\n' "$after"
    return 0
  fi

  printf '  %s new snapshot(s) this run; pruning to the newest %s\n' \
    "$((after - BACKUPS_BEFORE))" "$BACKUP_KEEP_LAST"
  ak backups prune --keep-last "$BACKUP_KEEP_LAST" --no-interactive
}

step_perms() {
  if [ "$DRY_RUN" = 1 ]; then
    dry_note "chmod +x on script files under $HOME/.claude"
    return 0
  fi
  find "$HOME/.claude" -type f \( \
    -name '*.sh' -o -name '*.bash' -o -name '*.fish' -o -name '*.zsh' \
    -o -name '*.ksh' -o -name '*.csh' -o -name '*.pl' -o -name '*.py' -o -name '*.rb' \
  \) -exec chmod +x {} +
}

# ── Register + run ────────────────────────────────────────────────────────────
upall_reset
upall_register binary     "AgentKit binary"     "command -v ak"                          step_binary
upall_register kit        "Engineer kit"        "command -v ak"                          step_kit
upall_register naming     "Date-first reports"  'command -v node && [ -f "$HOME/.claude/hooks/lib/context-builder.cjs" ]' step_naming
upall_register statusline "Restore statusline"  'command -v jq && [ -f "$HOME/.claude/settings.json" ]' step_statusline
upall_register perms      "Fix permissions"     '[ -d "$HOME/.claude" ]'                 step_perms
upall_register prune      "Prune backups"       "command -v ak"                          step_prune

TITLE="ak-update"
[ "$DRY_RUN" = 1 ] && TITLE="ak-update (dry-run)"
set_title "starting"
upall_begin "$TITLE"
upall_run_all
set_title "done"
upall_end "$TITLE"
exit $?
