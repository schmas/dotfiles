#!/usr/bin/env bash
# ck-update — refresh ClaudeKit config and reapply local customizations.
#
# Runs `ck init`, reapplies naming patches, restores the custom statusline, and
# fixes script permissions. Shares the upall TUI/runner engine: standalone it
# shows a fixed status header + live logs; when invoked by `upall`
# (UPALL_ACTIVE=1) it runs plain and streams into upall's output.

set -uo pipefail

LIB="$HOME/bin/lib/upall-lib.sh"
[ -f "$LIB" ] || LIB="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lib/upall-lib.sh"
# shellcheck source=/dev/null
. "$LIB" || { echo "ck-update: cannot load $LIB" >&2; exit 3; }

set_title() { printf '\033]0;ck-update: %s\007' "$1"; }

# ── Step implementations ──────────────────────────────────────────────────────
# shellcheck disable=SC2329  # step_* are dispatched indirectly via STEP_FNS[] (upall-lib.sh)
step_ckinit() {
  ck init -g --kit engineer --yes --install-skills --prefix \
    --docs-dir ".ck-docs" --plans-dir ".ck-plans"
}

step_naming() { "$HOME/bin/ck-reapply-claude-naming"; }

step_statusline() {
  local f="$HOME/.claude/settings.json"
  jq '.statusLine = {"type": "command", "command": "npx -y ccstatusline@latest", "padding": 0, "refreshInterval": 10}' \
    "$f" > "$f.tmp" && mv "$f.tmp" "$f"
}

step_perms() {
  find "$HOME/.claude" -type f \( \
    -name '*.sh' -o -name '*.bash' -o -name '*.fish' -o -name '*.zsh' \
    -o -name '*.ksh' -o -name '*.csh' -o -name '*.pl' -o -name '*.py' -o -name '*.rb' \
  \) -exec chmod +x {} +
}

# ── Register + run ────────────────────────────────────────────────────────────
upall_reset
upall_register ckinit     "ClaudeKit init"    "command -v ck"                          step_ckinit
upall_register naming     "Reapply naming"    '[ -x "$HOME/bin/ck-reapply-claude-naming" ]' step_naming
upall_register statusline "Restore statusline" 'command -v jq && [ -f "$HOME/.claude/settings.json" ]' step_statusline
upall_register perms      "Fix permissions"   '[ -d "$HOME/.claude" ]'                  step_perms

set_title "starting"
upall_begin "ck-update"
upall_run_all
set_title "done"
upall_end "ck-update"
exit $?
