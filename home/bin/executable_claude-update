#!/usr/bin/env bash

BOLD='\033[1m'
DIM='\033[2m'
GREEN='\033[0;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
NC='\033[0m'

step_names=()
step_results=()

set_title() { printf '\033]0;claude-update: %s\007' "$1"; }

section() {
  echo
  echo -e "${DIM}════════════════════════════════════════════════════════════════════════════════${NC}"
  echo -e "${BOLD}${CYAN}  $1${NC}"
  echo -e "${DIM}════════════════════════════════════════════════════════════════════════════════${NC}"
  set_title "$1"
}

run_step() {
  local name="$1"
  shift
  if "$@"; then
    step_names+=("$name")
    step_results+=("success")
  else
    step_names+=("$name")
    step_results+=("failed")
  fi
}

echo -e "${BOLD}Updating Claude Code configuration...${NC}"
set_title "starting"

# Pull latest config
section "Git pull ~/.claude"
cd ~/.claude
run_step "Git pull ~/.claude" git pull

# Update Claude CLI
section "Claude CLI"
run_step "Claude CLI update" claude update

# # Update ClaudeKit
# section "ClaudeKit"
# run_step "ClaudeKit init" ck init -g --kit engineer --yes --install-skills --prefix

# # Rename ClaudeKit skill-creator to avoid overriding Anthropic's plugin
# if [ -d ~/.claude/skills/skill-creator ]; then
#   rm -rf ~/.claude/skills/skill-creator.ck
#   mv ~/.claude/skills/skill-creator ~/.claude/skills/skill-creator.ck
#   echo -e "${GREEN}Renamed skill-creator → skill-creator.ck${NC}"
# fi

# # Restore custom statusline (ck update resets to default)
# section "Restore statusline"
# if [ -f ~/.claude/statusline-custom.cjs ]; then
#   if jq '.statusLine.command = "node $HOME/.claude/statusline-custom.cjs"' \
#     ~/.claude/settings.json > ~/.claude/settings.json.tmp \
#     && mv ~/.claude/settings.json.tmp ~/.claude/settings.json; then
#     step_names+=("Restore statusline")
#     step_results+=("success")
#     echo -e "${GREEN}Custom statusline restored${NC}"
#   else
#     step_names+=("Restore statusline")
#     step_results+=("failed")
#   fi
# else
#   echo -e "${YELLOW}No custom statusline found, using default${NC}"
# fi

# Fix permissions on all shell scripts (plugins/hooks may lose +x after update)
section "Fix permissions"
run_step "Fix permissions" find ~/.claude -type f \( \
  -name '*.sh' -o \
  -name '*.bash' -o \
  -name '*.fish' -o \
  -name '*.zsh' -o \
  -name '*.ksh' -o \
  -name '*.csh' -o \
  -name '*.pl' -o \
  -name '*.py' -o \
  -name '*.rb' \
\) -exec chmod +x {} +

# Backup any local changes
section "Backup"
run_step "Claude backup" claude-backup

# Summary report
set_title "done"
total=${#step_names[@]}
passed=0
failed=0
for i in "${!step_results[@]}"; do
  if [[ "${step_results[$i]}" == "success" ]]; then ((passed++)); else ((failed++)); fi
done

echo
echo -e "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}  Claude Update Summary${NC}  (${passed} passed, ${failed} failed, ${total} total)"
echo -e "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
for i in "${!step_names[@]}"; do
  n=$((i + 1))
  if [[ "${step_results[$i]}" == "success" ]]; then
    icon="✅"
    label="${GREEN}success${NC}"
  else
    icon="❌"
    label="${RED}failed${NC}"
  fi
  printf "  %2d. %-24s %s %b\n" "$n" "${step_names[$i]}" "$icon" "$label"
done
echo -e "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

if [[ $failed -gt 0 ]]; then
  echo -e "${RED}⚠️  ${failed} step(s) failed. Review output above.${NC}"
else
  echo -e "${GREEN}✅ Claude Code updated successfully!${NC}"
fi
