#!/usr/bin/env bash
set -euo pipefail

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${BLUE}Updating Claude Code configuration...${NC}"
echo

# Pull latest config
cd ~/.claude
git pull
echo

# Update Claude CLI
echo -e "${YELLOW}Updating Claude CLI...${NC}"
claude update
echo

# Update ClaudeKit
echo -e "${YELLOW}Updating ClaudeKit...${NC}"
# ck update
ck init -g --kit engineer --yes --install-skills --prefix
echo

# Rename ClaudeKit skill-creator to avoid overriding Anthropic's plugin
if [ -d ~/.claude/skills/skill-creator ]; then
  rm -rf ~/.claude/skills/skill-creator.ck
  mv ~/.claude/skills/skill-creator ~/.claude/skills/skill-creator.ck
  echo -e "${GREEN}Renamed skill-creator → skill-creator.ck${NC}"
fi

# Restore custom statusline (ck update resets to default)
echo -e "${YELLOW}Restoring custom statusline...${NC}"
if [ -f ~/.claude/statusline-custom.cjs ]; then
  jq '.statusLine.command = "node $HOME/.claude/statusline-custom.cjs"' \
    ~/.claude/settings.json > ~/.claude/settings.json.tmp \
    && mv ~/.claude/settings.json.tmp ~/.claude/settings.json
  echo -e "${GREEN}Custom statusline restored${NC}"
else
  echo -e "${YELLOW}No custom statusline found, using default${NC}"
fi
echo

# Fix permissions on all shell scripts (plugins/hooks may lose +x after update)
echo -e "${YELLOW}Fixing script permissions...${NC}"
find ~/.claude -type f \( \
  -name '*.sh' -o \
  -name '*.bash' -o \
  -name '*.fish' -o \
  -name '*.zsh' -o \
  -name '*.ksh' -o \
  -name '*.csh' -o \
  -name '*.pl' -o \
  -name '*.py' -o \
  -name '*.rb' \
\) -exec chmod +x {} +
echo -e "${GREEN}Script permissions fixed${NC}"
echo

# Backup any local changes
echo -e "${YELLOW}Backing up...${NC}"
claude-backup
echo

echo -e "${YELLOW}Migrating to Cursor agent...${NC}"
ck migrate --agent cursor --global --yes
echo -e "${GREEN}Cursor agent migrated successfully${NC}"
echo

echo -e "${GREEN}Claude Code updated successfully${NC}"
