#!/usr/bin/env bash
# watch-git-index-lock — Monitor .git/index.lock create/delete events
# Uses fs_usage (macOS) for real-time filesystem monitoring.
# Shows which process creates and removes index.lock files.
# Useful for diagnosing stale locks (process creates but never removes).
#
# Usage:
#   watch-git-index-lock [path...]
#
# Examples:
#   watch-git-index-lock                          # watches ~/projects/work/aaa
#   watch-git-index-lock ~/projects/work/aaa      # same, explicit
#   watch-git-index-lock ~/repo1 ~/repo2          # watch multiple trees
#
# Requires: sudo (fs_usage needs root)
#
# How to read the output:
#   Look for an "open" (with C=create flag) without a matching "unlink"
#   from the same PID — that process left a stale lock.
#
# fs_usage flags: R=read W=write C=create E=exclusive (O_EXCL)

set -uo pipefail

DEFAULT_PATHS=("$HOME/projects/work/aaa")
WATCH_PATHS=("${@:-${DEFAULT_PATHS[@]}}")
LOG_FILE="${TMPDIR:-/tmp}/git-index-lock-$(date +%Y%m%d-%H%M%S).log"

# Kill any leftover fs_usage from previous runs
if pgrep -f 'fs_usage -w -f filesys' >/dev/null 2>&1; then
  echo "Killing previous fs_usage processes..."
  sudo pkill -f 'fs_usage -w -f filesys' 2>/dev/null || true
  sleep 1
fi

FS_PID=""
cleanup() {
  echo ""
  echo "Stopping..."
  [ -n "$FS_PID" ] && kill "$FS_PID" 2>/dev/null || true
  sudo pkill -f 'fs_usage -w -f filesys' 2>/dev/null || true
  echo "Log: $LOG_FILE"
}
trap cleanup EXIT INT TERM

echo "=== watch-git-index-lock ==="
echo "Watching for index.lock events in:"
for p in "${WATCH_PATHS[@]}"; do
  echo "  - $p"
done
echo "Log: $LOG_FILE"
echo "Press Ctrl+C to stop."
echo ""

# Build grep -E pattern for watched paths (BSD grep compatible)
path_pattern=$(printf '%s|' "${WATCH_PATHS[@]}" | sed 's/|$//')

# Process events inline.
# Disable set -e — grep returns 1 when no match, which is normal.
set +e

# Run fs_usage in foreground — the script blocks here until Ctrl+C.
sudo fs_usage -w -f filesys 2>/dev/null | while IFS= read -r line; do
  # Fast path: skip lines not mentioning index.lock
  case "$line" in
    *index.lock*) ;;
    *) continue ;;
  esac

  # Check watched paths
  match=false
  for wp in "${WATCH_PATHS[@]}"; do
    case "$line" in
      *"$wp"*) match=true; break ;;
    esac
  done
  $match || continue

  # Skip noise syscalls
  case "$line" in
    *stat64*|*lstat64*|*getattrlist*|*fstat*|*access*|*fsgetpath*|*statfs*|*fstatat*) continue ;;
  esac

  timestamp=$(date '+%Y-%m-%d %H:%M:%S')

  # Extract process.pid (last token)
  proc_pid="${line##* }"
  case "$proc_pid" in
    *.*.*)
      process="${proc_pid%.*.*}"
      remainder="${proc_pid#*.}"
      pid="${remainder%%.*}"
      ;;
    *.*)
      process="${proc_pid%.*}"
      pid="${proc_pid##*.}"
      ;;
    *)
      process="$proc_pid"
      pid="?"
      ;;
  esac

  # Resolve parent process
  parent=""
  ppid=$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d ' ') || true
  if [ -n "$ppid" ] && [ "$ppid" != "0" ] && [ "$ppid" != "1" ]; then
    parent_name=$(ps -p "$ppid" -o comm= 2>/dev/null) || parent_name="?"
    parent=" <- $parent_name ($ppid)"
  fi

  # Extract path and syscall
  path=$(echo "$line" | grep -oE '[^ ]*index\.lock[^ ]*' | head -1)
  syscall="${line%%[[:space:]]*}"

  output="$timestamp | $syscall | $process ($pid)$parent | $path"
  echo "$output"
  echo "$output" >> "$LOG_FILE"
done
