#!/usr/bin/env bash
# Setup Claude Code CLI and user configuration
# Standalone script for manual execution (also embedded in chezmoi run_once script)

set -e
set -u
set -o pipefail

# ~/.claude is managed by chezmoi (dot_claude); there is no external
# claude-config repo to clone anymore.

# Install Claude Code CLI
install_claude_code() {
  if command -v claude >/dev/null 2>&1 || [ -x "$HOME/.local/bin/claude" ]; then
    echo "Claude Code CLI already installed"
    return 0
  fi

  echo "Installing Claude Code CLI..."
  if ! curl -fsSL https://claude.ai/install.sh | bash; then
    echo "Error: Claude CLI installation failed" >&2
    return 1
  fi
}

# Register MCP servers at user scope
setup_mcp_servers() {
  if ! command -v claude >/dev/null 2>&1; then
    echo "Claude CLI not found, skipping MCP setup"
    return 0
  fi

  echo "Setting up MCP servers..."

  # Fetch installed list once to avoid repeated slow calls
  local installed
  installed="$(claude mcp list 2>/dev/null || true)"

  if ! echo "$installed" | grep -q "^human-mcp:"; then
    claude mcp add -e "GOOGLE_GEMINI_API_KEY=\${GEMINI_API_KEY}" -s user \
      human-mcp -- npx @goonnguyen/human-mcp || echo "Warning: failed to add human-mcp"
  else
    echo "human-mcp already configured"
  fi

  if ! echo "$installed" | grep -q "^chrome-devtools:"; then
    claude mcp add -s user chrome-devtools -- npx -y chrome-devtools-mcp@latest \
      || echo "Warning: failed to add chrome-devtools"
  else
    echo "chrome-devtools already configured"
  fi

  if ! echo "$installed" | grep -q "^sequential-thinking:"; then
    claude mcp add -s user sequential-thinking -- npx -y @modelcontextprotocol/server-sequential-thinking \
      || echo "Warning: failed to add sequential-thinking"
  else
    echo "sequential-thinking already configured"
  fi

  if ! echo "$installed" | grep -q "^obsidian:"; then
    local vault_path
    vault_path="$(readlink -f "$HOME/Obsidian_Vault" 2>/dev/null || echo "$HOME/Obsidian_Vault")"
    claude mcp add -s user obsidian -- npx -y obsidian-mcp "$vault_path" \
      || echo "Warning: failed to add obsidian-mcp"
  else
    echo "obsidian-mcp already configured"
  fi
}

# Display plugin installation instructions
show_plugin_instructions() {
  echo ""
  echo "=== Claude Code Setup Complete ==="
  echo "To install plugins, open Claude Code and run:"
  echo "  /install claude-plugins-official"
  echo "  /install mgrep"
  echo ""
}

# Main execution
main() {
  echo "=== Claude Code Setup ==="
  # ~/.claude is managed by chezmoi; just install the CLI and register MCP
  # servers — no config repo clone.
  install_claude_code
  setup_mcp_servers
  show_plugin_instructions
}

# Allow running individual functions: setup-claude-code mcp
case "${1:-}" in
  mcp) setup_mcp_servers ;;
  *)   main "$@" ;;
esac
