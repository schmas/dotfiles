#!/usr/bin/env fish

echo -e "Updating all the things..."

echo -e "\nOS Update..."
if command -v osupdate >/dev/null 2>&1
    osupdate
end

{{ if eq .using_nix true -}}
if test -d ~/.config/nix-config
    nix-config-update
end
{{ else -}}
if type brew >/dev/null 2>&1
    echo -e "\nUpdating brew..."
    brewup
end
{{ end }}

if command -q mise
    echo -e "\nUpdating mise..."
    # mise self-update --yes
    mise up
    mise completion fish >~/.config/fish/completions/mise.fish
else
  if type rustup >/dev/null 2>&1
      echo -e "\nUpdating rust and cargo deps..."
      rustup update
      cargo install-update -a
  end
end

if command -q chezmoi
    echo -e "\nUpdating chezmoi..."
    chezmoi update
end

if functions -q fisher
    echo -e "\nUpdating fisher..."
    fisher update
end

echo -e "\nUpdating finished..."
