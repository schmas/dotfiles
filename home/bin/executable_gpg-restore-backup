#!/usr/bin/env bash

set -e
set -u
set -o pipefail

# Define file paths
private_keys="${HOME}/.gnupg/bkp/private.gpg"
pub_keys="${HOME}/.gnupg/bkp/public.gpg"
owner_trust="${HOME}/.gnupg/bkp/trust.gpg"

gpg-download-op

# Check if all files exist
if [[ ! -f "$private_keys" || ! -f "$pub_keys" || ! -f "$owner_trust" ]]; then
    exit 0
fi

# Import GPG keys and owner trust data
gpg --import "$private_keys"
gpg --import "$pub_keys"
gpg --import-ownertrust "$owner_trust"

# List the imported keys
gpg -K
gpg -k

rm -rf "$private_keys" "$pub_keys" "$owner_trust"
