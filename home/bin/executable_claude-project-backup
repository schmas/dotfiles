#!/usr/bin/env bash
# Claude & Cursor Project Settings Backup/Restore Script
# Usage: claude-project-backup [backup|restore]

set -euo pipefail

BACKUP_BASE="$HOME/Documents/01.1_Projects/01_AAA_Connect+"
PROJECTS_BASE="$HOME/projects/work/aaa"

PROJECTS=(
  "connect-plus-data-migration"
  "connect-plus-backend"
  "connect-plus-frontend"
)

AI_FILES=(".claude" "CLAUDE.md" "CLAUDE.local.md" ".cursor" ".cursorrules" ".cursorignore")

backup_project() {
  local project_name="$1"
  local project_path="$PROJECTS_BASE/$project_name"
  local backup_dir="$BACKUP_BASE/$project_name"
  local items=()

  [[ ! -d "$project_path" ]] && { echo "⚠ Project not found: $project_name"; return; }
  mkdir -p "$backup_dir"

  for item in "${AI_FILES[@]}"; do
    if [[ -d "$project_path/$item" ]]; then
      rsync -a --delete "$project_path/$item/" "$backup_dir/$item/"
      items+=("$item/")
    elif [[ -f "$project_path/$item" ]]; then
      cp "$project_path/$item" "$backup_dir/$item"
      items+=("$item")
    fi
  done

  [[ ${#items[@]} -eq 0 ]] && echo "⚪ $project_name: No AI files" || echo "✓ $project_name: ${items[*]}"
}

restore_project() {
  local project_name="$1"
  local project_path="$PROJECTS_BASE/$project_name"
  local backup_dir="$BACKUP_BASE/$project_name"
  local items=()

  [[ ! -d "$backup_dir" ]] && { echo "⚠ No backup found: $project_name"; return; }
  [[ ! -d "$project_path" ]] && { echo "⚠ Project not found: $project_name"; return; }

  for item in "${AI_FILES[@]}"; do
    if [[ -d "$backup_dir/$item" ]]; then
      rsync -a --delete "$backup_dir/$item/" "$project_path/$item/"
      items+=("$item/")
    elif [[ -f "$backup_dir/$item" ]]; then
      cp "$backup_dir/$item" "$project_path/$item"
      items+=("$item")
    fi
  done

  [[ ${#items[@]} -eq 0 ]] && echo "⚪ $project_name: Nothing to restore" || echo "✓ $project_name: ${items[*]}"
}

ACTION="${1:-backup}"

case "$ACTION" in
  backup)
    echo "Backing up AI settings to: $BACKUP_BASE"
    echo "---"
    for project in "${PROJECTS[@]}"; do backup_project "$project"; done
    ;;
  restore)
    echo "Restoring AI settings from: $BACKUP_BASE"
    echo "Projects: ${PROJECTS[*]}"
    echo ""
    read -p "This will overwrite existing files. Continue? [y/N] " -n 1 -r
    echo ""
    [[ ! $REPLY =~ ^[Yy]$ ]] && { echo "Aborted."; exit 0; }
    echo "---"
    for project in "${PROJECTS[@]}"; do restore_project "$project"; done
    ;;
  *)
    echo "Usage: claude-project-backup [backup|restore]"
    exit 1
    ;;
esac

echo "---"
echo "Done."
