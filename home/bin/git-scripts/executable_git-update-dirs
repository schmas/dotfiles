#!/usr/bin/env bash

set -Eeuo pipefail
trap cleanup SIGINT SIGTERM ERR EXIT

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)

usage() {
  cat <<EOF
Usage: $(basename "${BASH_SOURCE[0]}") [-h] [-v] [-i] -b branch_name TARGET_DIR

This shell script automates the process of updating all Git repositories contained within a specified directory or the top level directory by default.
It checks out the main branch and pulls the latest changes from the remote repository.
Additionally, it has an option to run npm install for each directory containing a package.json file if the --install argument is passed when executing the script.
This script can be useful for maintaining multiple repositories or projects with a large number of directories.

Available options:

-h, --help      Print this help and exit
-v, --verbose   Print script debug info
-i, --install   Execute 'npm install' for folders that have package.json
-b, --banch     Branch name to be checkout. Default is main
EOF
  exit
}

cleanup() {
  trap - SIGINT SIGTERM ERR EXIT
  # script cleanup here
}

setup_colors() {
  if [[ -t 2 ]] && [[ -z "${NO_COLOR-}" ]] && [[ "${TERM-}" != "dumb" ]]; then
    NOFORMAT='\033[0m' RED='\033[0;31m' GREEN='\033[0;32m' ORANGE='\033[0;33m' BLUE='\033[0;34m' PURPLE='\033[0;35m' CYAN='\033[0;36m' YELLOW='\033[1;33m'
  else
    NOFORMAT='' RED='' GREEN='' ORANGE='' BLUE='' PURPLE='' CYAN='' YELLOW=''
  fi
}

msg() {
  echo >&2 -e "${1-}"
}

die() {
  local msg=$1
  local code=${2-1} # default exit status 1
  msg "$msg"
  exit "$code"
}

parse_params() {
  # default values of variables set from params
  install=0
  branch='main'

  while :; do
    case "${1-}" in
    -h | --help) usage ;;
    -v | --verbose) set -x ;;
    --no-color) NO_COLOR=1 ;;
    -i | --install) install=1 ;; # example install
    -b | --branch)               # example named parameter
      branch="${2-}"
      shift
      ;;
    -?*) die "Unknown option: $1" ;;
    *) break ;;
    esac
    shift
  done

  args=("$@")

  # check required params and arguments
  [[ -z "${branch-}" ]] && die "Missing required parameter: branch"
  # [[ ${#args[@]} -eq 0 ]] && die "Missing script arguments"
  [[ ${#args[@]} -eq 0 ]] && die "Missing TARGET_DIR script arguments"

  return 0
}

parse_params "$@"
setup_colors

# script logic here

msg "${RED}Read parameters:${NOFORMAT}"
msg "- install: ${install}"
msg "- branch: ${branch}"
# msg "- arguments: ${args[*]-}"
msg "- target: ${args[0]-}"

targetDir="${args[0]-}"
# Loop through all directories recursively
for dir in $(find ${targetDir} -maxdepth 1 -type d); do
  echo ""
  msg "${YELLOW}$dir${NOFORMAT}"

  # Check if the directory contains a Git repository
  if [[ -d "$dir/.git" ]]; then
    # Move into the directory and checkout the main branch
    cd $dir
    git checkout ${branch} || true

    # Pull the latest changes from the remote repository
    git pull --all --tags --prune --progress --verbose || true

    # Move back to the parent directory
    cd $targetDir
  fi

  # Check if the --install argument is passed and if a package.json file exists in the directory
  if [[ $install -eq 1 && -f "$dir/package.json" ]]; then
    # Move into the directory and run npm install
    cd $dir
    npm install || true

    # Move back to the parent directory
    cd $targetDir
  fi
done
