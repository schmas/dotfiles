#!/usr/bin/env python3
"""aaa-db-dump — move a remote AAA Postgres database into a Docker Postgres.

Five stages, each gated on an independent re-check that its input really exists:

    dump (on bastion) -> fetch (to Mac) -> push (to target) -> restore -> clean

    aaa-db-dump run uat2 --to win-dev --yes
    aaa-db-dump run uat2 --to local --yes
    aaa-db-dump status uat2 --to win-dev
    aaa-db-dump list

Two shapes skip stages rather than run all five:

    aaa-db-dump dump uat2                       # dump on the bastion, nothing else
    aaa-db-dump run uat2 --stop-after fetch     # dump and bring it down, no restore

    # a dump obtained by hand: no bastion, no dump, no fetch
    aaa-db-dump run uat2 --to win-dev --yes \
        --archive ~/Downloads/nationaluat2-2026_09_02-1400

--archive takes a pg_dump directory or a single dump file already on this
machine, and drives push and restore from it. It never writes state["archive"],
so `clean` still refuses to delete a bastion dump that this restore did not
come from.

Dump sources and restore destinations are separate namespaces. --to resolves
only against restore_targets in databases.yaml, so a team-environment source
alias can never be a destination.

Every subprocess in this file is launched by run(). That single chokepoint is
what makes --dry-run a trustworthy preview of a real run.
"""

import argparse
import base64
import json
import os
import re
import shlex
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover - bootstrap path
    _venv = Path.home() / ".local/share/schmas-aaa-db/.venv/bin/python3"
    if _venv.exists() and os.environ.get("_AAA_DB_DUMP_REEXEC") != "1":
        os.environ["_AAA_DB_DUMP_REEXEC"] = "1"
        os.execv(str(_venv), [str(_venv), __file__, *sys.argv[1:]])
    sys.exit("PyYAML not available; run setup-aaa-db-wrapper.sh or pip install pyyaml")

CONFIG_PATH = Path.home() / ".config" / "etc" / "databases.yaml"
STATE_DIR = Path.home() / ".local" / "state" / "aaa-db"

# Top-level keys in databases.yaml that are settings, not database aliases.
# aaa-db-query.py carries the same set; both tools must skip them.
RESERVED = {"dump_dir", "restore_targets"}

STAGES = ["dump", "fetch", "push", "restore", "clean"]
SUBCOMMANDS = STAGES + ["run", "status", "list", "completion"]

# Measured on 2026-09-02 against nationaluat2: 20m23s, 9.7 GB, 434 files.
DUMP_JOBS = 4
DUMP_COMPRESS = "gzip:6"
RESTORE_JOBS = 4

# How many dumps of one database may sit on the shared bastion at once, the
# one about to be written included. Each is ~10 GB, so this is a disk budget,
# not a preference: the dump stage deletes the oldest ones down to this.
BASTION_KEEP = 2

# Values that must never reach a terminal, a log, or an argv.
_SECRETS = set()


def redact(text):
    """Mask every known password before any text is printed."""
    for secret in _SECRETS:
        if secret:
            text = text.replace(secret, "***REDACTED***")
    return text


def die(msg, code=2):
    print(f"aaa-db-dump: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


class Result:
    """What run() returns. `stopped` means a sentinel ended a follow early."""

    __slots__ = ("rc", "out", "err", "stopped")

    def __init__(self, rc=0, out="", err="", stopped=False):
        self.rc = rc
        self.out = out
        self.err = err
        self.stopped = stopped

    @property
    def ok(self):
        return self.rc == 0

    def text(self):
        return (self.out or "").strip()


def run(cmd, *, dry, capture=False, stdin_text=None, tee=None, stop_on=None,
        collect=None, timeout=None):
    """The only subprocess launch in this script.

    dry        print the fully interpolated command and return a success stub
    capture    buffer stdout/stderr instead of letting them through
    stdin_text feed on stdin (how the dump script's password reaches the bastion
               without ever appearing in a world-readable argv)
    tee        append streamed output to this local file
    stop_on    stop streaming when a line contains one of these strings
    collect    keep streamed lines matching this compiled regex
    """
    streaming = tee is not None or stop_on is not None or collect is not None
    if streaming and stdin_text is not None:
        # Popen below is not wired for stdin, and stdin_text is what keeps the
        # password out of argv. Fail loudly rather than send an empty script.
        raise ValueError("stdin_text cannot be combined with a streaming read")

    printable = redact(getattr(cmd, "display", None) or shlex.join(cmd))
    if dry:
        print(f"  $ {printable}")
        if stdin_text is not None:
            for line in redact(stdin_text).splitlines():
                print(f"  | {line}")
        return Result(0, "", "")

    print(f"  $ {printable}", file=sys.stderr)
    if not streaming:
        proc = subprocess.run(
            cmd, input=stdin_text, text=True, timeout=timeout,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
        )
        # Captured streams are printed by several die() sites, so they get the
        # same masking as anything else that reaches a terminal.
        return Result(proc.returncode,
                      redact(proc.stdout or ""), redact(proc.stderr or ""))

    kept, tail, stopped = [], [], False
    handle = open(tee, "a", encoding="utf-8") if tee else None
    proc = subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, bufsize=1,
    )
    try:
        for line in proc.stdout:
            line = redact(line.rstrip("\n"))
            print(line)
            if handle:
                handle.write(line + "\n")
            tail.append(line)
            del tail[:-50]
            if collect is not None and collect.search(line):
                kept.append(line)
            if stop_on and any(s in line for s in stop_on):
                stopped = True
                proc.terminate()
                break
    finally:
        if handle:
            handle.close()
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()  # reap it, or returncode stays None
    out = "\n".join(kept if kept else tail)
    # A child we had to kill has no exit status of its own. Calling that
    # success would let a hung restore be recorded as complete.
    rc = 0 if stopped else proc.returncode
    return Result(1 if rc is None else rc, out, "", stopped)


class Cmd(list):
    """argv that remembers the readable command it wraps.

    remote() ships commands base64-encoded, which is unreadable. --dry-run has
    to keep printing what will actually run, so the readable form travels with
    the argv rather than being reconstructed from it.
    """

    __slots__ = ("display",)


def remote(host, command):
    """argv running a shell command on `host`, or locally when host is falsy.

    The remote login shell is not ours to choose. win-dev logs into fish, which
    rejects POSIX `$?` and brace groups -- so a compound command exits 127
    while the simple ones in the same stage succeed, which is how a restore
    came to DROP a database and then never reload it. Quoting cannot bridge
    that: fish does not accept the `'"'"'` escape shlex.quote emits, so any
    psql -c '...' would break in turn.

    Base64 is the one encoding every shell forwards untouched -- no quotes left
    for a login shell to reinterpret -- so the command reaches bash verbatim
    whatever the user's shell happens to be. Remote hosts are Linux, where
    `base64 -d` is GNU coreutils.
    """
    if host:
        blob = base64.b64encode(command.encode()).decode()
        cmd = Cmd(["ssh", host,
                   f"echo {blob} | base64 -d | bash --noprofile --norc"])
        cmd.display = f"ssh {shlex.quote(host)} {shlex.quote(command)}"
        return cmd
    return ["bash", "-c", command]


# --------------------------------------------------------------------------
# Config
# --------------------------------------------------------------------------

def load_config():
    if not CONFIG_PATH.exists():
        die(f"config not found: {CONFIG_PATH}\n"
            "  copy databases.yaml.example there and fill it in")
    return yaml.safe_load(CONFIG_PATH.read_text()) or {}


# A Postgres identifier we are willing to splice into SQL and into a path.
IDENTIFIER_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_$]{0,62}$")


def check_identifier(name, what):
    """Refuse anything that is not a plain identifier.

    shlex.quote protects the shell, not SQL: psql -c accepts several
    statements, so an unchecked --db could drop a database it was never
    pointed at. It also lands in a state-file path.
    """
    if not IDENTIFIER_RE.match(str(name or "")):
        die(f"{what} {name!r} is not a plain database identifier "
            "(letters, digits, _ and $, not starting with a digit)")
    return str(name)


def source_aliases(cfg):
    return {k: v for k, v in cfg.items()
            if k not in RESERVED and isinstance(v, dict)}


def get_source(alias, cfg, *, need_bastion=False):
    """Resolve a dump source. MSSQL and bastion-less aliases are refused here."""
    aliases = source_aliases(cfg)
    src = aliases.get(alias)
    if src is None:
        die(f"unknown source alias {alias!r}; known: {', '.join(sorted(aliases))}")
    src = dict(src)
    src.setdefault("type", "postgresql")
    src.setdefault("port", 5432)
    src.setdefault("sslmode", "require")
    if src["type"] != "postgresql":
        die(f"{alias!r} is {src['type']}; MSSQL sources are not supported — "
            "this pipeline is pg_dump/pg_restore only")
    missing = [k for k in ("host", "dbname", "user", "password")
               if not src.get(k)]
    if missing:
        die(f"source alias {alias!r} is missing {', '.join(missing)}")
    # The database name reaches a remote shell (the bastion dump path and the
    # glob that drives the retention sweep) and the local filesystem, so it is
    # held to the same rule as --db rather than trusted because it came from a
    # file the user owns.
    src["dbname"] = check_identifier(src["dbname"], f"{alias} dbname")
    if src.get("password"):
        _SECRETS.add(str(src["password"]))
    if need_bastion and not src.get("bastion"):
        die(f"{alias!r} has no 'bastion:' key, so there is no host to dump on.\n"
            "  (the restore target named 'local' is a different thing with the "
            "same name — see --to)")
    return src


def get_target(name, cfg):
    """Resolve a restore destination.

    Looks only in restore_targets. That is the whole guarantee: a source alias
    passed to --to is rejected automatically, whatever it is named.
    """
    targets = cfg.get("restore_targets") or {}
    if not isinstance(targets, dict) or not targets:
        die("databases.yaml has no 'restore_targets:' block; "
            "there is nowhere to restore to")
    if name not in targets:
        die(f"unknown restore target {name!r}; legal targets: "
            f"{', '.join(sorted(targets))}\n"
            "  (source aliases are dump sources only, never destinations)")
    target = dict(targets[name])
    for key in ("host", "port"):
        if key in target:
            die(f"restore target {name!r} carries {key!r}; restore targets are "
                "docker-exec only and have no host/port fields")
    for key in ("host_path", "container", "container_path", "db", "user"):
        if not target.get(key):
            die(f"restore target {name!r} is missing required key {key!r}")
    target["name"] = name
    return target


def get_dump_dir(cfg):
    value = cfg.get("dump_dir")
    if not value:
        die("databases.yaml has no 'dump_dir:' key")
    return Path(str(value)).expanduser()


# An archive name becomes a directory component inside a remote shell command,
# an rsync path, and a container path — three places that would each need their
# own quoting. Refusing the awkward names at the door is one rule instead.
ARCHIVE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")


def check_archive_name(name, what):
    if not ARCHIVE_NAME_RE.match(str(name or "")):
        die(f"{what} {name!r} is not a usable archive name.\n"
            "  letters, digits, dot, dash and underscore only, starting with "
            "a letter or a digit. Rename it and try again.")
    return str(name)


def archive_name(dbname, stamp=None):
    """<dbname>-<YYYY_MM_DD-HHMM>, the one naming rule every stage shares.

    Local time, so the directory name reads back as the wall clock of whoever
    started the dump. The clock is a label here, not a key: the dump records
    this name in the state file and every later stage reads it back, so a run
    that spans midnight or a timezone change still agrees on one directory.
    """
    stamp = stamp or datetime.now().strftime("%Y_%m_%d-%H%M")
    return check_archive_name(f"{dbname}-{stamp}", "the generated archive name")


def bastion_out(archive):
    """Where pg_dump writes on the bastion. $HOME is the bastion's, not ours,
    so it is left for the remote shell to expand.

    Keyed on the archive name, not the database name: the name carries the
    dump's time, so a second dump never overwrites the first, and `fetch` can
    name the exact directory it came for instead of hoping only one exists.
    """
    return f"$HOME/dumps/{archive}"


def bastion_glob(dbname):
    """Every dump directory of one database on the bastion, as a shell glob.

    The stamp sorts lexicographically, so `ls -1d | sort` is chronological.
    A pre-timestamp directory (plain `dumps/<dbname>`) does not match, and is
    therefore never deleted by the retention sweep.
    """
    return f"$HOME/dumps/{dbname}-*"


def bastion_out_rel(archive):
    """The same directory as an rsync source.

    rsync resolves a remote path relative to the remote user's home, so this
    form needs no shell expansion — openrsync gives no guarantee that a $HOME
    inside a remote path is ever expanded.
    """
    return f"dumps/{archive}"


# --------------------------------------------------------------------------
# State
# --------------------------------------------------------------------------

def state_path(alias):
    return STATE_DIR / f"{alias}.state.json"


def load_state(alias):
    path = state_path(alias)
    if not path.exists():
        return {"alias": alias, "stages": {}}
    try:
        return json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return {"alias": alias, "stages": {}}


def save_state(state, *, dry):
    """Write only the stages this process touched.

    A dump holds its state object across a 20-minute follow. Writing the whole
    snapshot at the end would erase whatever another shell recorded meanwhile.
    """
    if dry:
        return
    touched = set(state.pop("_touched", ()))
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    path = state_path(state["alias"])
    on_disk = load_state(state["alias"]) if path.exists() else {"stages": {}}

    merged = dict(on_disk)
    merged.update({k: v for k, v in state.items() if k != "stages"})
    stages = dict(on_disk.get("stages", {}))
    for name in touched:
        if name in state.get("stages", {}):
            stages[name] = state["stages"][name]
        else:
            stages.pop(name, None)
    merged["stages"] = stages

    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(merged, indent=2, sort_keys=True))
    tmp.replace(path)
    state["_touched"] = touched


def record(state, stage, **fields):
    entry = state.setdefault("stages", {}).setdefault(stage, {})
    entry.update(fields)
    entry["at"] = now()
    state.setdefault("_touched", set()).add(stage)
    return entry


def clear_stages(state, *names):
    """Forget stages whose input a new dump has just replaced."""
    for name in names:
        state.get("stages", {}).pop(name, None)
        state.setdefault("_touched", set()).add(name)


def stage_status(state, stage):
    return state.get("stages", {}).get(stage, {}).get("status")


def resolved_archive(state, dbname, *, cfg, dry):
    """Reuse the archive name the dump recorded; else take the newest on disk.

    A dump made yesterday and fetched today must still agree on one directory
    name, so the state file is the carrier rather than the clock. Since the
    name carries a time, a later stage cannot re-derive it from the clock the
    way a date-only name allowed -- so when state is missing, the newest
    <dbname>-* directory already in dump_dir is the only honest guess. The
    stamp sorts lexicographically, so the newest name is the last one.
    """
    name = state.get("archive")
    if name:
        # The state file is on disk and hand-editable; it does not get to name
        # a directory that later stages splice into a remote command.
        return check_archive_name(name, "the archive recorded in state")
    on_disk = sorted(p.name for p in get_dump_dir(cfg).glob(f"{dbname}-*")
                     if p.is_dir())
    if on_disk:
        name = check_archive_name(on_disk[-1], "the newest archive in dump_dir")
        if not dry and state.get("stages"):
            print(f"  # no archive recorded in state; using the newest in "
                  f"dump_dir: {name}")
        return name
    name = archive_name(dbname)
    if not dry and state.get("stages"):
        print(f"  # no archive recorded in state and none in dump_dir; "
              f"assuming {name}")
    return name


def manual_archive(args):
    """The path given with --archive, resolved once, or None.

    Resolved here rather than at each use so every stage of one invocation
    agrees on a single absolute path and a single directory name.
    """
    value = getattr(args, "archive", None)
    if not value:
        return None
    path = Path(value).expanduser()
    if not path.exists():
        die(f"--archive {value}: no such file or directory")
    # Its last component travels to the destination as a directory or file
    # name, through ssh and rsync. A space alone would break the rsync path.
    check_archive_name(path.name, "--archive")
    return path.resolve()


def archive_for(args, state, dbname, *, cfg, dry):
    """(local path, archive name) for the stage about to run.

    With --archive the caller supplied both, and nothing is read from state:
    a hand-downloaded dump has no dump or fetch record to read.
    """
    manual = manual_archive(args)
    if manual:
        return manual, manual.name
    name = resolved_archive(state, dbname, cfg=cfg, dry=dry)
    return get_dump_dir(cfg) / name, name


def log_path(alias, stage):
    return STATE_DIR / f"{alias}-{stage}.log"


# --------------------------------------------------------------------------
# Shared helpers
# --------------------------------------------------------------------------

ERROR_RE = re.compile(r"pg_restore: error")

# Printed by the restore command itself so the real exit status survives the
# pipe to tee, which would otherwise report tee's status instead.
EXIT_SENTINEL = "AAA_DB_DUMP_PG_RESTORE_EXIT="


FOLLOW_MAX_RECONNECTS = 60  # ~5 minutes of outage before handing back


def follow(host, log, sentinels, *, dry):
    """Reconnecting tail. A dropped VPN kills this viewer, never the work."""
    print(f"  following {log} — ctrl-c detaches the viewer, the work keeps going")
    cmd = remote(host, f"tail -n 60 -F {log}")
    for attempt in range(FOLLOW_MAX_RECONNECTS):
        result = run(cmd, dry=dry, stop_on=sentinels)
        if dry or result.stopped:
            return result
        print(f"  [reconnecting in 5s, {attempt + 1}/{FOLLOW_MAX_RECONNECTS}]")
        time.sleep(5)
    # Bounded on purpose: an unbounded loop would hang `run` forever with the
    # VPN down. The work itself is detached and unaffected.
    print("  giving up on the viewer — the remote work is unaffected.")
    print(f"  re-attach with: aaa-db-dump status {log.rsplit('-', 1)[0]}")
    return Result(1, "", "", False)


def zmx_hint(alias):
    """A copy-pasteable detachable session for the long stages.

    -d is mandatory: a bare `zmx run` dies with its calling process and takes
    the session down with it.
    """
    argv = " ".join(shlex.quote(a) for a in sys.argv[1:])
    return f"zmx run aaa-db-dump-{alias} -d aaa-db-dump {argv}"


def container_psql(dest, sql, *, db="postgres", tuples=True):
    """docker exec ... psql, as a shell string.

    Every database access in this script is built here or in the pg_restore
    line below, so nothing can reach a database outside the container the
    config named — there is no -h code path.
    """
    flags = "-t -A " if tuples else ""
    return (f"docker exec {shlex.quote(dest['container'])} "
            f"psql -U {shlex.quote(dest['user'])} -d {shlex.quote(db)} "
            f"-v ON_ERROR_STOP=1 {flags}-c {shlex.quote(sql)}")


def parse_count(text, what):
    """A remote `wc -l` should be a number; a login-shell banner is not."""
    try:
        return int((text or "").strip().splitlines()[-1])
    except (ValueError, IndexError):
        die(f"could not read {what} from the remote output: {text!r}")


def local_file_count(path):
    """Members of a directory archive, or 1 for a single-file archive.

    os.walk on a file yields nothing, which would read as an empty archive and
    trip the restore pre-flight for every custom-format dump.
    """
    path = Path(path)
    if path.is_file():
        return 1
    return sum(len(files) for _, _, files in os.walk(path))


def archive_meta(local_archive, *, dry):
    """Source server major and required extensions, read from the archive TOC."""
    result = run(["pg_restore", "--list", str(local_archive)],
                 dry=dry, capture=True)
    version, extensions = None, []
    # Anchor on the TOC's own desc column rather than substring-matching the
    # line: a "COMMENT - EXTENSION x" entry would otherwise contribute its
    # owner as a required extension.
    toc = re.compile(r"^\d+;\s+\d+\s+\d+\s+EXTENSION\s+\S+\s+(\S+)")
    for line in result.out.splitlines():
        match = re.search(r"Dumped from database version:\s*(\d+)", line)
        if match:
            version = int(match.group(1))
        entry = toc.match(line.strip())
        if entry:
            extensions.append(entry.group(1))
    return version, sorted(set(extensions))


def verify_archive(local_archive, *, dry):
    """Full decompress with the output discarded — the check that catches a
    truncated or corrupted transfer in about a minute."""
    return run(["pg_restore", "--file=/dev/null", str(local_archive)],
               dry=dry, capture=True)


# --------------------------------------------------------------------------
# Stage: dump
# --------------------------------------------------------------------------

def prune_bastion_dumps(bastion, dbname, *, dry):
    """Delete the oldest dumps of `dbname` so the new one lands under the cap.

    Run before the dump, not after: the point is to free the disk the next
    ~10 GB needs. Listed and deleted in two steps so the exact directories
    appear on the terminal — this deletes a dump that took 20 minutes to make.
    """
    keep = max(BASTION_KEEP - 1, 0)  # the dump about to start takes a slot
    print(f"  gate: at most {BASTION_KEEP} dumps of {dbname} stay on {bastion}")
    listing = run(remote(bastion, f"ls -1d {bastion_glob(dbname)} 2>/dev/null || true"),
                  dry=dry, capture=True)
    if dry:
        print("    --dry-run: the listing above was not read, so nothing is "
              "shown as removable")
        return
    if not listing.ok:
        # `|| true` hides ls's status, so a non-zero one here is ssh itself
        # failing. An empty answer would then read as "no old dumps", which is
        # the wrong basis for both the count and the deletions.
        die(f"could not list the dumps on {bastion} (ssh exited {listing.rc}), "
            "so there is no safe way to decide what to delete. Nothing was "
            "removed and no dump was started.", code=1)

    # Every line here would become an `rm -rf` argument, and remote stdout is
    # not a list of paths: a login shell prints banners (the same reason
    # parse_count exists). A stray line also sorts after real paths, so it
    # would take the keep slot and the newest dump would be deleted in its
    # place. Anything not shaped like a dump of this database stops the sweep
    # rather than being quietly dropped.
    wanted = re.compile(rf"^/.*/dumps/{re.escape(dbname)}-[^/]+$")
    found, junk = [], []
    for line in listing.text().splitlines():
        line = line.strip().rstrip("/")
        if line:
            (found if wanted.match(line) else junk).append(line)
    if junk:
        die(f"unexpected output while listing dumps on {bastion}:\n"
            + "\n".join(f"    {line}" for line in junk)
            + "\n  each of those would have become an `rm -rf` argument. "
              "Nothing was removed and no dump was started.", code=1)

    # The stamp makes lexicographic order chronological, so the last entries
    # are the ones worth keeping.
    found.sort()
    stale = found[:-keep] if keep else found
    print(f"    {len(found)} already there; removing {len(stale)}")
    if not stale:
        return
    for path in stale:
        print(f"    rm -rf {path}")
    pruned = run(remote(bastion, "rm -rf " + " ".join(shlex.quote(p) for p in stale)),
                 dry=dry, capture=True)
    if not pruned.ok:
        die(f"could not remove older dumps from {bastion}, so the new one may "
            f"not fit: {pruned.err.strip()[:300]}", code=1)


def cmd_dump(args, cfg):
    src = get_source(args.alias, cfg, need_bastion=True)
    bastion, dbname = src["bastion"], src["dbname"]
    # Named once, here. The name carries minutes, so deriving it a second time
    # after the ssh round trips below could roll to the next minute and leave
    # the bastion directory and the recorded name pointing at each other's
    # neighbour.
    archive = archive_name(dbname)
    out = bastion_out(archive)
    script = f"$HOME/dump-{args.alias}.sh"
    remote_log = f"$HOME/dump-{args.alias}.log"
    state = load_state(args.alias)

    print(f"dump {args.alias} ({dbname}) on {bastion}")
    print(f"  archive {archive}")
    if args.command == "dump":
        print("  this takes ~20 min. To follow it and still walk away:")
        print(f"    {zmx_hint(args.alias)}")
    print("  gate: no pg_dump is already writing that output directory")
    # The [p] keeps the pattern from matching the shell that carries it.
    pattern = f"[p]g_dump.*--file=.*dumps/{dbname}"
    probe = run(remote(bastion, f"pgrep -f -- {shlex.quote(pattern)} || true"),
                dry=args.dry_run, capture=True)
    if not args.dry_run and probe.text():
        if not args.force_dump:
            die(f"a pg_dump is already writing {out} on {bastion} "
                f"(pid {probe.text().split()}).\n"
                "  pass --force-dump only once you have confirmed none is "
                "running")
        print("  --force-dump: continuing despite a matching process")

    body = "\n".join([
        "#!/usr/bin/env bash",
        "set -euo pipefail",
        f"export PGPASSWORD={shlex.quote(str(src['password']))}",
        f"export PGSSLMODE={shlex.quote(str(src['sslmode']))}",
        f'OUT="{out}"',
        'mkdir -p "$(dirname "$OUT")"',
        'rm -rf "$OUT"',  # pg_dump refuses an existing directory
        'echo "DUMP_START $(date -u +%FT%TZ)"',
        "pg_dump \\",
        f"  -h {shlex.quote(str(src['host']))} -p {src['port']} "
        f"-U {shlex.quote(str(src['user']))} -d {shlex.quote(dbname)} \\",
        f"  --format=directory --jobs={DUMP_JOBS} --compress={DUMP_COMPRESS} \\",
        "  --no-owner --no-privileges --lock-wait-timeout=30s --verbose \\",
        '  --file="$OUT"',
        'echo "DUMP_FILES $(find "$OUT" -type f | wc -l | tr -d \' \')"',
        'echo "DUMP_DONE $(date -u +%FT%TZ)"',
    ])
    # stdin, never argv: the bastion is shared and argv is world-readable in ps.
    # umask first, so the file is never briefly world-readable while the
    # password is being written into it.
    written = run(
        remote(bastion, f"umask 077 && cat > {script} && chmod 700 {script}"),
        dry=args.dry_run, stdin_text=body + "\n", capture=True)
    if not args.dry_run and not written.ok:
        die("could not write the dump script to the bastion (no dump "
            f"started): {written.err.strip()[:300]}", code=1)

    check = run(remote(bastion, f"test -s {script} && bash -n {script}"),
                dry=args.dry_run, capture=True)
    if not args.dry_run and not check.ok:
        die("the generated dump script failed bash -n on the bastion "
            f"(no dump started):\n{check.err.strip()}")

    # Last, not first: this deletes a dump that took 20 minutes to make. Every
    # reason the new dump might never start — an ssh drop, a bad script — has
    # already been ruled out by the two gates above.
    prune_bastion_dumps(bastion, dbname, dry=args.dry_run)

    launch = (
        "command -v setsid >/dev/null 2>&1 && SETSID=setsid || SETSID=; "
        f"rm -f {remote_log}; "
        f"$SETSID nohup {script} > {remote_log} 2>&1 < /dev/null & "
        "echo LAUNCHED $!"
    )
    launched = run(remote(bastion, launch), dry=args.dry_run, capture=True)
    if not args.dry_run and not launched.ok:
        die(f"could not launch the dump: {launched.err.strip()}")

    state["dbname"] = dbname
    state["archive"] = archive
    state["bastion"] = bastion
    # A new dump invalidates everything downstream. Without this, `run` would
    # skip fetch/push/restore as "already done" and leave the destination
    # holding the previous dump's data.
    clear_stages(state, "fetch", "push", "restore", "clean")
    record(state, "dump", status="running", out=out, log=remote_log,
           script=script, archive=archive, started_at=now())
    save_state(state, dry=args.dry_run)
    print(f"  dump running detached; log: {bastion}:{remote_log}")
    print(f"  re-attach any time with: aaa-db-dump status {args.alias}")

    if args.follow:
        follow(bastion, remote_log, ["DUMP_DONE", "DUMP_FAILED", "error:"],
               dry=args.dry_run)
        if not args.dry_run:
            done = run(remote(bastion, f"grep -c DUMP_DONE {remote_log} || true"),
                       dry=False, capture=True)
            if done.text() not in ("", "0"):
                record(state, "dump", status="complete", finished_at=now())
                save_state(state, dry=False)
    return 0


# --------------------------------------------------------------------------
# Stage: fetch
# --------------------------------------------------------------------------

def cmd_fetch(args, cfg):
    src = get_source(args.alias, cfg, need_bastion=True)
    bastion, dbname = src["bastion"], src["dbname"]
    remote_log = f"$HOME/dump-{args.alias}.log"
    state = load_state(args.alias)
    archive = resolved_archive(state, dbname, cfg=cfg, dry=args.dry_run)
    out = bastion_out(archive)
    dest = get_dump_dir(cfg) / archive

    print(f"fetch {args.alias} -> {dest}")
    print("  gate: the bastion log contains DUMP_DONE")
    gate = run(remote(bastion, f"grep -c DUMP_DONE {remote_log} || true"),
               dry=args.dry_run, capture=True)
    if not args.dry_run and gate.text() in ("", "0"):
        die(f"{remote_log} on {bastion} has no DUMP_DONE line — the dump is "
            "still running or it failed. Nothing was fetched.")

    # The archive name now carries a time, so a stale state file names a
    # directory that may simply not be there. Say which one, and say what is.
    print(f"  gate: {out} exists on the bastion")
    probe = run(remote(bastion, f'test -d "{out}" && echo present || echo absent'),
                dry=args.dry_run, capture=True)
    if not args.dry_run and probe.text().splitlines()[-1:] != ["present"]:
        listing = run(remote(bastion, f"ls -1d {bastion_glob(dbname)} 2>/dev/null || true"),
                      dry=False, capture=True)
        have = listing.text() or "    (no dump directory for this database)"
        die(f"{out} is not on {bastion}.\n"
            f"  the state file names {archive!r}; the bastion holds:\n{have}\n"
            f"  run `aaa-db-dump dump {args.alias}` to make a fresh one. "
            "Nothing was fetched.")

    run(["mkdir", "-p", str(dest)], dry=args.dry_run)
    # -a and -P are the intersection of GNU rsync and macOS openrsync.
    # Re-running resumes; never start over.
    # --delete removes members left by an earlier interrupted fetch of this
    # same archive. Without it, orphans keep local_count above the bastion's
    # and the count check below can never pass again.
    rsync = run(["rsync", "-a", "-P", "--delete",
                 f"{bastion}:{bastion_out_rel(archive)}/", f"{dest}/"],
                dry=args.dry_run)
    if not args.dry_run and not rsync.ok:
        die(f"rsync exited {rsync.rc}. Re-run `aaa-db-dump fetch {args.alias}` "
            "— it resumes where it stopped.", code=1)

    print("  check: local file count equals the bastion's")
    counted = run(remote(bastion, f'find "{out}" -type f | wc -l'),
                  dry=args.dry_run, capture=True)
    local_count = 0 if args.dry_run else local_file_count(dest)
    if not args.dry_run:
        expected = parse_count(counted.text(), "the bastion file count")
        print(f"  bastion {expected} files, local {local_count} files")
        if expected and expected != local_count:
            die(f"file count mismatch ({expected} vs {local_count}); "
                f"re-run fetch to resume", code=1)

    print("  verify: full decompress of every member file, output discarded")
    verified = verify_archive(dest, dry=args.dry_run)
    if not args.dry_run and not verified.ok:
        record(state, "fetch", status="failed", verified=False)
        save_state(state, dry=False)
        die("the local archive failed pg_restore --file=/dev/null; it is "
            f"incomplete or corrupt:\n{verified.err.strip()[:800]}", code=1)

    state["dbname"] = dbname
    state["archive"] = archive
    record(state, "fetch", status="complete", verified=True,
           path=str(dest), file_count=local_count)
    save_state(state, dry=args.dry_run)
    print(f"  archive verified at {dest}")
    return 0


# --------------------------------------------------------------------------
# Stage: push
# --------------------------------------------------------------------------

def cmd_push(args, cfg):
    src = get_source(args.alias, cfg)
    dest = get_target(args.to, cfg)
    state = load_state(args.alias)
    local, archive = archive_for(args, state, src["dbname"],
                                 cfg=cfg, dry=args.dry_run)
    manual = manual_archive(args) is not None

    print(f"push {args.alias} -> {dest['name']}")
    print(f"  archive {local}")
    print("  gate: the local archive is verified")
    verified = state.get("stages", {}).get("fetch", {}).get("verified")
    # A hand-supplied archive has no fetch record, and nothing in this pipeline
    # has ever read it — which is exactly when the check earns its minute.
    if not args.dry_run and (manual or not verified):
        print("  verifying now: full decompress, output discarded")
        if not verify_archive(local, dry=False).ok:
            die(f"{local} did not pass pg_restore --file=/dev/null; "
                "nothing was pushed", code=1)
        if not manual:
            # Never recorded for --archive: the flag would then vouch for a
            # different archive on the next run of this alias.
            record(state, "fetch", verified=True)
            save_state(state, dry=False)

    # Path-based skip, not name-based: a target with no ssh hop whose host_path
    # already holds this archive needs no copy. An ssh target always copies,
    # even if its path string happens to match ours — it is a different machine.
    host_path = Path(dest["host_path"]).expanduser()
    same_place = not dest.get("ssh") and local.parent == host_path
    if same_place:
        print(f"  skipped: {host_path} is {dest['name']}'s container mount "
              "— the archive is already in place")
        record(state, "push", status="skipped",
               reason="the archive already sits in the container mount",
               destination=dest["name"], archive=archive)
        save_state(state, dry=args.dry_run)
        return 0

    ssh = dest.get("ssh")
    if local.is_file():
        # A single-file archive is one member, not a tree. It is copied into
        # the mount directory, and without --delete: that flag against a
        # directory of unrelated archives would erase all of them.
        run(remote(ssh, f"mkdir -p {shlex.quote(dest['host_path'])}"),
            dry=args.dry_run)
        into = f"{ssh}:{dest['host_path']}/" if ssh else f"{dest['host_path']}/"
        cmd = ["rsync", "-a", "-P", str(local), into]
        remote_dir = f"{dest['host_path']}/{archive}"
    else:
        remote_dir = f"{dest['host_path']}/{archive}"
        run(remote(ssh, f"mkdir -p {shlex.quote(remote_dir)}"), dry=args.dry_run)
        # A destination with no ssh key is a path on this machine, so rsync
        # gets a plain local path. Using dest["ssh"] unconditionally raised
        # KeyError.
        into = f"{ssh}:{remote_dir}/" if ssh else f"{remote_dir}/"
        cmd = ["rsync", "-a", "-P", "--delete", f"{local}/", into]
    pushed = run(cmd, dry=args.dry_run)
    if not args.dry_run and not pushed.ok:
        die(f"rsync exited {pushed.rc}. Re-run push — it resumes.", code=1)

    record(state, "push", status="complete", destination=dest["name"],
           archive=archive, path=remote_dir)
    save_state(state, dry=args.dry_run)
    print(f"  archive on {dest['name']} at {remote_dir}")
    return 0


# --------------------------------------------------------------------------
# Stage: restore
# --------------------------------------------------------------------------

def cmd_restore(args, cfg):
    src = get_source(args.alias, cfg)
    dest = get_target(args.to, cfg)
    # --db is applied AFTER destination resolution: it renames the database
    # inside the resolved destination and can never change the host,
    # container, or ssh hop.
    db = check_identifier(args.db or dest["db"], "database")
    ssh = dest.get("ssh")
    hop = ssh or "localhost (no ssh hop)"
    state = load_state(args.alias)
    local, archive = archive_for(args, state, src["dbname"],
                                 cfg=cfg, dry=args.dry_run)
    manual = manual_archive(args) is not None
    in_container = f"{dest['container_path']}/{archive}"

    print(f"restore {args.alias} -> {dest['name']}")
    print(f"  database   {db}")
    print(f"  container  {dest['container']}")
    print(f"  ssh hop    {hop}")
    print(f"  archive    {in_container}")

    print("  pre-flight: container is running")
    inspect = f"docker inspect -f '{{{{.State.Running}}}}' {shlex.quote(dest['container'])}"
    running = run(remote(ssh, inspect), dry=args.dry_run, capture=True)
    if not args.dry_run and running.text() != "true":
        die(f"container {dest['container']} is not running on {hop}; "
            "nothing was touched")

    print("  pre-flight: the container sees the expected number of files")
    # `find -type f` so this counts the same thing local_file_count() does;
    # `ls | wc -l` would count only top-level entries.
    inner = f"find {shlex.quote(in_container)} -type f | wc -l"
    listed = run(
        remote(ssh, f"docker exec {shlex.quote(dest['container'])} "
                    f"sh -c {shlex.quote(inner)}"),
        dry=args.dry_run, capture=True)
    # The fetch record's count was written only after the archive passed
    # verification, so it is the number worth comparing against: a live count
    # of an archive that lost members after verification would agree with the
    # container and let the loss through. A hand-supplied archive has no such
    # record, and push verified it moments ago, so there the live count is the
    # honest one.
    expected = state.get("stages", {}).get("fetch", {}).get("file_count")
    if manual or expected is None:
        expected = local_file_count(local) if local.exists() else None
    if not args.dry_run:
        seen = parse_count(listed.text(), "the container file count")
        print(f"  container sees {seen} files, expected {expected or 'unknown'}")
        if seen == 0:
            die(f"the container sees nothing at {in_container}. The mount is not "
                "where the config says. Nothing was dropped.")
        # An interrupted push leaves a partial archive that would otherwise be
        # restored over a dropped database.
        if expected and seen != expected:
            die(f"the container sees {seen} files but the verified archive has "
                f"{expected}. The copy is incomplete — re-run push. "
                "Nothing was dropped.")

    print("  pre-flight: container Postgres major >= source major")
    src_major, extensions = archive_meta(local, dry=args.dry_run)
    if not args.dry_run and src_major is None:
        # Both remaining pre-flight gates read the archive TOC. If it cannot be
        # read, they would silently pass rather than check anything.
        die(f"could not read the archive TOC at {local}, so the version and "
            "extension checks cannot run. Re-run fetch. Nothing was dropped.")
    version = run(remote(ssh, container_psql(dest, "SHOW server_version")),
                  dry=args.dry_run, capture=True)
    if not args.dry_run:
        try:
            dest_major = int(version.text().split(".")[0])
        except ValueError:
            die(f"could not read the container's server_version: {version.text()!r}")
        print(f"  source major {src_major}, container major {dest_major}")
        if src_major and dest_major < src_major:
            die(f"container Postgres {dest_major} is older than the source's "
                f"{src_major}; the restore would fail part-way")

    print("  pre-flight: every extension the archive needs is available")
    available = run(
        remote(ssh, container_psql(
            dest, "SELECT name FROM pg_available_extensions")),
        dry=args.dry_run, capture=True)
    if not args.dry_run and extensions:
        have = set(available.text().split())
        missing = [e for e in extensions if e not in have]
        print(f"  archive needs: {', '.join(extensions)}")
        if missing:
            die(f"the container has no {', '.join(missing)} extension; "
                "nothing was dropped")

    size_sql = f"SELECT pg_size_pretty(pg_database_size('{db}'))"
    size = run(remote(ssh, container_psql(dest, size_sql)),
               dry=args.dry_run, capture=True)
    if args.dry_run:
        current = "not read (--dry-run)"
    else:
        current = size.text() if size.ok else "absent"
    pre_drop = STATE_DIR / f"{args.alias}-{db}-pre-drop-tables.txt"

    if not args.yes:
        print("")
        print("  this stage is destructive. It will DROP and recreate:")
        print(f"    database   {db}")
        print(f"    size now   {current}")
        print(f"    container  {dest['container']}")
        print(f"    ssh hop    {hop}")
        print(f"  the current table list is written to {pre_drop} first, so")
        print("  anything only present there stays knowable afterwards.")
        print("  re-run with --yes to proceed. Nothing was touched.")
        return 2

    print(f"  recording the current table list to {pre_drop}")
    tables_sql = ("SELECT schemaname||'.'||tablename FROM pg_tables "
                  "WHERE schemaname NOT IN ('pg_catalog','information_schema') "
                  "ORDER BY 1")
    before = run(remote(ssh, container_psql(dest, tables_sql, db=db)),
                 dry=args.dry_run, capture=True)
    if not args.dry_run:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if before.ok:
            pre_drop.write_text(before.out)
        elif current == "absent":
            pre_drop.write_text(f"# {db} did not exist before this restore\n")
        else:
            # Writing an empty file here would quietly remove the only record
            # of what the drop is about to destroy.
            die(f"could not read {db}'s table list, so what the drop would "
                f"destroy cannot be recorded: {before.err.strip()[:300]}\n"
                "  nothing was dropped.", code=1)

    # A single open session makes DROP DATABASE fail, so evict first — and
    # never fall back to --clean, which is what lost two primary keys before.
    terminate = ("SELECT pg_terminate_backend(pid) FROM pg_stat_activity "
                 f"WHERE datname = '{db}' AND pid <> pg_backend_pid()")
    for attempt in range(1, 4):
        print(f"  evict clients, then DROP DATABASE (attempt {attempt}/3)")
        run(remote(ssh, container_psql(dest, terminate)),
            dry=args.dry_run, capture=True)
        dropped = run(
            remote(ssh, container_psql(dest, f'DROP DATABASE IF EXISTS "{db}"')),
            dry=args.dry_run, capture=True)
        if args.dry_run or dropped.ok:
            break
        print(f"    {dropped.err.strip()[:200]}")
        time.sleep(3)
    else:
        die(f"could not DROP DATABASE {db} after 3 attempts — a client keeps "
            "reconnecting. Find it in pg_stat_activity and retry; do not fall "
            "back to --clean.", code=1)

    created = run(
        remote(ssh, container_psql(
            dest, f'CREATE DATABASE "{db}" OWNER "{dest["user"]}"')),
        dry=args.dry_run, capture=True)
    if not args.dry_run and not created.ok:
        die(f"CREATE DATABASE {db} failed: {created.err.strip()[:300]}", code=1)

    restore_log = log_path(args.alias, "restore")
    if not args.dry_run:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        restore_log.unlink(missing_ok=True)
    remote_log = f"$HOME/aaa-db-dump-{args.alias}-restore.log"
    # No --clean and no --if-exists: the database was just recreated, so there
    # is nothing to clean and nothing of the previous one can survive.
    #
    # The `{ ...; echo EXIT=$?; } | tee` shape is deliberate. A plain
    # `cmd | tee log` reports tee's status, so a pg_restore killed by a dropped
    # VPN would come back as exit 0 with no error lines, and `clean` would then
    # delete the only remaining copy of the dump.
    pg_restore = (
        "{ docker exec " + shlex.quote(dest["container"]) +
        f" pg_restore -U {shlex.quote(dest['user'])} -d {shlex.quote(db)} "
        f"--no-owner --no-privileges --jobs={RESTORE_JOBS} --verbose "
        f"{shlex.quote(in_container)} 2>&1; "
        f'echo "{EXIT_SENTINEL}$?"; }} | tee {remote_log}'
    )
    result = run(remote(ssh, pg_restore), dry=args.dry_run,
                 tee=None if args.dry_run else restore_log, collect=ERROR_RE)

    errors, error_lines, pg_exit = 0, [], None
    if not args.dry_run and restore_log.exists():
        for line in restore_log.read_text(errors="replace").splitlines():
            if ERROR_RE.search(line):
                errors += 1
                if len(error_lines) < 20:
                    error_lines.append(line)
            marker = re.search(rf"{EXIT_SENTINEL}(\d+)", line)
            if marker:
                pg_exit = int(marker.group(1))
    if args.dry_run:
        pg_exit = 0
    if pg_exit is None:
        # The stream ended before pg_restore reported anything — a dropped
        # connection, a killed container, a terminated child.
        print("  the restore stream ended without an exit status; "
              "treating it as failed")
        pg_exit = result.rc or 1

    after_size = run(remote(ssh, container_psql(dest, size_sql)),
                     dry=args.dry_run, capture=True)
    count_sql = ("SELECT count(*) FROM pg_tables WHERE schemaname "
                 "NOT IN ('pg_catalog','information_schema')")
    after_tables = run(remote(ssh, container_psql(dest, count_sql, db=db)),
                       dry=args.dry_run, capture=True)

    # exit code and error count are different facts; never collapse them,
    # and never treat either alone as proof of success.
    print("")
    print(f"  pg_restore_exit={pg_exit}")
    print(f"  pg_restore_errors={errors}")
    if error_lines:
        print("  distinct errors:")
        for line in sorted(set(error_lines)):
            print(f"    {line}")
    if not args.dry_run:
        print(f"  {db} is now {after_size.text() or '?'} across "
              f"{after_tables.text() or '?'} tables")
    clean_restore = errors == 0 and pg_exit == 0
    if clean_restore:
        print("  RESTORE_DONE")
    elif errors:
        print(f"  RESTORE_ERRORS {errors}")
    else:
        print(f"  RESTORE_FAILED exit={pg_exit} with no error lines — the "
              "restore did not finish")

    record(state, "restore",
           status="complete" if clean_restore else "errors",
           destination=dest["name"], db=db,
           archive=archive,  # so clean can tell which dump this belongs to
           pg_restore_exit=pg_exit,
           pg_restore_errors=errors, errors=sorted(set(error_lines)),
           size=after_size.text(), tables=after_tables.text())
    save_state(state, dry=args.dry_run)
    return 0 if clean_restore else 1


# --------------------------------------------------------------------------
# Stage: clean
# --------------------------------------------------------------------------

def cmd_clean(args, cfg):
    src = get_source(args.alias, cfg, need_bastion=True)
    bastion, dbname = src["bastion"], src["dbname"]
    state = load_state(args.alias)
    restored = state.get("stages", {}).get("restore", {})
    errors = restored.get("pg_restore_errors")

    print(f"clean {args.alias} on {bastion}")
    exit_code = restored.get("pg_restore_exit")
    recorded = errors if errors is not None else "unrecorded"
    archive = state.get("archive")
    restored_archive = restored.get("archive")
    dump_running = stage_status(state, "dump") == "running"

    # Three separate questions, because a pass on one says nothing about the
    # others. The archive check is what stops a day-old success record from
    # authorising the deletion of a dump taken this morning.
    reasons = []
    if errors != 0:
        reasons.append(f"pg_restore_errors={recorded}")
    if exit_code != 0:
        reasons.append(f"pg_restore_exit={exit_code if exit_code is not None else 'unrecorded'}")
    if restored_archive != archive:
        reasons.append(f"the recorded restore was of {restored_archive!r}, "
                       f"not the current {archive!r}")
    if dump_running:
        reasons.append("a dump is still marked running")

    print("  gate: the recorded restore of THIS archive finished cleanly")
    print(f"    pg_restore_errors={recorded}, pg_restore_exit="
          f"{exit_code if exit_code is not None else 'unrecorded'}, "
          f"restored archive={restored_archive!r}, current={archive!r}")
    print(f"    -> {'pass' if not reasons else 'REFUSE'}")

    if args.dry_run and reasons:
        # A dry run destroys nothing, so it shows the rest of the plan rather
        # than stopping. A real run refuses here.
        print("    --dry-run: a real run would stop here; "
              "showing the remaining commands anyway")
    if not args.dry_run and reasons:
        if not args.force_clean:
            for line in restored.get("errors", [])[:20]:
                print(f"    {line}")
            die("refusing to delete the only remaining copy of a 20-minute "
                f"dump: {'; '.join(reasons)}.\n"
                "  inspect the restore first, or pass --force-clean once you "
                "have confirmed it is safe.")
        print(f"  --force-clean: overriding {'; '.join(reasons)}")
        for line in restored.get("errors", [])[:20]:
            print(f"    overriding: {line}")

    # $HOME stays unquoted so the remote shell expands it; everything after it
    # is quoted, because this is the one destructive command in the script.
    # Only the archive this run is about, never the whole dumps/ tree: another
    # dump of the same database may legitimately still be sitting beside it.
    target = archive or resolved_archive(state, dbname, cfg=cfg, dry=args.dry_run)
    paths = [
        f"$HOME/dumps/{shlex.quote(target)}",
        f"$HOME/{shlex.quote(f'dump-{args.alias}.sh')}",
        f"$HOME/{shlex.quote(f'dump-{args.alias}.log')}",
        f"$HOME/{shlex.quote(f'follow-{args.alias}.sh')}",
    ]
    print("  deleting from the bastion:")
    for path in paths:
        print(f"    {path}")
    print(f"  dump-{args.alias}.sh holds the database password in plain text on "
          "a shared host — removing it is the point, the disk space is a bonus.")

    removed = run(remote(bastion, "rm -rf " + " ".join(paths)),
                  dry=args.dry_run, capture=True)
    if not args.dry_run and not removed.ok:
        die(f"cleanup failed: {removed.err.strip()[:300]}", code=1)
    run(remote(bastion, "df -h $HOME | tail -1"), dry=args.dry_run)

    record(state, "clean", status="complete")
    save_state(state, dry=args.dry_run)
    return 0


# --------------------------------------------------------------------------
# run — the five stages, gated, resumable
# --------------------------------------------------------------------------

def stage_output_intact(stage, state):
    """Re-check a completed stage's output instead of trusting the state file."""
    if stage == "fetch":
        path = state.get("stages", {}).get("fetch", {}).get("path")
        return bool(path) and Path(path).is_dir()
    return True


def cmd_run(args, cfg):
    # Resolve the destination up front, so an unknown one costs nothing —
    # never after a 20-minute dump.
    manual = manual_archive(args) is not None
    dest = get_target(args.to, cfg) if args.to else None
    # A hand-supplied archive needs no bastion: nothing is dumped on one, and
    # nothing is deleted from one afterwards.
    src = get_source(args.alias, cfg, need_bastion=not manual)

    if manual:
        stages = [("push", cmd_push), ("restore", cmd_restore)]
    else:
        stages = [("dump", cmd_dump), ("fetch", cmd_fetch), ("push", cmd_push),
                  ("restore", cmd_restore), ("clean", cmd_clean)]

    where = dest["name"] if dest else "nowhere (stopping before push)"
    db = args.db or (dest["db"] if dest else "n/a")
    print(f"run {args.alias} -> {where} (database {db})")
    if manual:
        print("  --archive: dump, fetch and clean are skipped; this run only "
              "pushes and restores what you supplied.")
    elif args.stop_after:
        print(f"  stopping after [{args.stop_after}]. To follow it and still "
              "walk away:")
        print(f"    {zmx_hint(args.alias)}")
    else:
        print("  all five stages take ~50 min. To follow them and still walk "
              "away:")
        print(f"    {zmx_hint(args.alias)}")


    # A dump replaces the input of every later stage. cmd_dump clears them in
    # the state file, but --dry-run writes nothing, so track it here as well —
    # otherwise a dry run would claim stages are "already done" that a real run
    # would re-execute.
    invalidated = set()

    for index, (name, handler) in enumerate(stages):
        state = load_state(args.alias)
        done = stage_status(state, name)
        # Re-read per stage: the dump that just ran named a new archive, and a
        # stage recorded against a different one is not "already done" for this
        # run — it belongs to another dump.
        _, current_archive = archive_for(args, state, src["dbname"],
                                         cfg=cfg, dry=args.dry_run)
        recorded = state.get("stages", {}).get(name, {}).get("archive")
        other_archive = bool(recorded) and recorded != current_archive
        if (done in ("complete", "skipped") and args.redo != name
                and name not in invalidated and not other_archive):
            if stage_output_intact(name, state):
                print(f"\n[{name}] already done (use --redo {name} to force)")
                if args.stop_after == name:
                    return 0
                continue
            print(f"\n[{name}] marked {done} but its output is gone; re-running")
        elif other_archive:
            print(f"\n[{name}] was recorded against {recorded}, not "
                  f"{current_archive}; re-running")
        print(f"\n[{name}]")
        rc = handler(args, cfg)
        if name == "dump" and not rc:
            invalidated.update(("fetch", "push", "restore", "clean"))
        if rc:
            print(f"\ngate failed at [{name}] (exit {rc}).")
            remaining = [later for later, _ in stages[index + 1:]]
            if remaining:
                print("  these did not run, and nothing they touch was changed:")
                for later in remaining:
                    print(f"    {later}")
            else:
                print("  this was the last stage.")
            return rc
        if args.stop_after == name:
            print(f"\nstopping after [{name}] as requested")
            return 0
    return 0


# --------------------------------------------------------------------------
# status — answers from a cold shell, by re-checking rather than remembering
# --------------------------------------------------------------------------

def cmd_status(args, cfg):
    src = get_source(args.alias, cfg)
    state = load_state(args.alias)
    dbname = src["dbname"]
    local, archive = archive_for(args, state, dbname, cfg=cfg, dry=True)

    print(f"{args.alias}  ({dbname})")
    print(f"  archive        {archive}")
    print(f"  state file     {state_path(args.alias)}")

    dest = get_target(args.to, cfg) if args.to else None
    if dest:
        db = args.db or dest["db"]
        print(f"  destination    {dest['name']}")
        print(f"    container    {dest['container']}")
        print(f"    ssh hop      {dest.get('ssh') or 'localhost (no ssh hop)'}")
        print(f"    database     {db}")

    print("")
    print("  live checks")
    bastion = src.get("bastion")
    if bastion:
        if manual_archive(args):
            # The bastion never held this archive, so probing it for that name
            # would report an absence that means nothing.
            print("    bastion archive   n/a (--archive names a local dump)")
        else:
            out = bastion_out(archive)
            probe = f'test -d "{out}" && find "{out}" -type f | wc -l || echo absent'
            found = run(remote(bastion, probe), dry=args.dry_run, capture=True)
            print(f"    bastion archive   {found.text() or 'unreachable'}")
        # At most BASTION_KEEP of these exist; showing them makes the retention
        # sweep's next victim visible before it runs.
        listing = run(remote(bastion, f"ls -1d {bastion_glob(dbname)} 2>/dev/null || true"),
                      dry=args.dry_run, capture=True)
        for line in listing.text().splitlines():
            print(f"    on bastion        {line.rstrip('/')}")
    else:
        print("    bastion archive   n/a (alias has no bastion)")

    if local.exists():
        print(f"    local archive     {local_file_count(local)} files at {local}")
    else:
        print(f"    local archive     absent ({local})")

    if dest:
        db = args.db or dest["db"]
        remote_dir = f"{dest['host_path']}/{archive}"
        probe = (f"test -d {shlex.quote(remote_dir)} && "
                 f"find {shlex.quote(remote_dir)} -type f | wc -l || echo absent")
        found = run(remote(dest.get("ssh"), probe),
                    dry=args.dry_run, capture=True)
        print(f"    destination copy  {found.text() or 'unreachable'}")
        size_sql = f"SELECT pg_size_pretty(pg_database_size('{db}'))"
        size = run(remote(dest.get("ssh"), container_psql(dest, size_sql)),
                   dry=args.dry_run, capture=True)
        print(f"    {db:<16}  {size.text() if size.ok else 'absent or unreachable'}")

    print("")
    print("  recorded stages")
    for name in STAGES:
        entry = state.get("stages", {}).get(name, {})
        if not entry:
            print(f"    {name:<9} not started")
            continue
        extra = ""
        if name == "restore":
            extra = (f"  errors={entry.get('pg_restore_errors')}"
                     f" exit={entry.get('pg_restore_exit')}"
                     f" db={entry.get('db')}")
        if name == "push" and entry.get("reason"):
            extra = f"  ({entry['reason']})"
        print(f"    {name:<9} {entry.get('status', '?'):<9} "
              f"{entry.get('at', '')}{extra}")
    return 0


# --------------------------------------------------------------------------
# list — so an exact name is never something to remember
# --------------------------------------------------------------------------

def cmd_list(args, cfg):
    sources = source_aliases(cfg)
    destinations = cfg.get("restore_targets") or {}

    if args.aliases_only:
        # Machine-readable, for shell completion. Postgres only: completing an
        # MSSQL alias that dump then rejects is a trap.
        for alias in sorted(sources):
            if sources[alias].get("type", "postgresql") == "postgresql":
                print(alias)
        return 0

    if args.targets_only:
        for name in sorted(destinations):
            print(name)
        return 0

    print("dump sources (read-only; never restore destinations)")
    print(f"  {'alias':<20} {'type':<11} {'host':<52} {'database':<20} "
          f"{'bastion':<8} writable")
    for alias in sorted(sources):
        cfg_row = sources[alias]
        print(f"  {alias:<20} {cfg_row.get('type', 'postgresql'):<11} "
              f"{str(cfg_row.get('host', '?')):<52} "
              f"{str(cfg_row.get('dbname', '?')):<20} "
              f"{'yes' if cfg_row.get('bastion') else 'no':<8} "
              f"{'yes' if cfg_row.get('writable') else 'no'}")

    print("")
    print("restore destinations (--to; the only places a restore may land)")
    print(f"  {'name':<20} {'ssh':<11} {'container':<32} database")
    for name in sorted(destinations):
        row = destinations[name] or {}
        print(f"  {name:<20} {str(row.get('ssh') or 'local'):<11} "
              f"{str(row.get('container', '?')):<32} {row.get('db', '?')}")

    print("")
    print(f"dump_dir  {cfg.get('dump_dir', '(unset)')}")
    return 0


# --------------------------------------------------------------------------
# completion — the values only the config knows, read at completion time
# --------------------------------------------------------------------------

COMPLETION_FISH = r"""# aaa-db-dump completions for fish
# Regenerate with: aaa-db-dump completion fish

set -l __add_stages dump fetch push restore clean run status list completion
set -l __add_takes_alias dump fetch push restore clean run status

complete -c aaa-db-dump -f
complete -c aaa-db-dump -n "not __fish_seen_subcommand_from $__add_stages" \
    -a "$__add_stages"
complete -c aaa-db-dump -n "__fish_seen_subcommand_from $__add_takes_alias" \
    -a "(aaa-db-dump list --aliases-only)" -d "source alias"
complete -c aaa-db-dump -n "__fish_seen_subcommand_from completion" \
    -a "fish bash zsh" -d shell
complete -c aaa-db-dump -l to -x -a "(aaa-db-dump list --targets-only)" \
    -d "restore destination"
complete -c aaa-db-dump -l db -x -d "database name inside the destination"
complete -c aaa-db-dump -l archive -r -F \
    -d "a dump already on this machine (skips dump and fetch)"
complete -c aaa-db-dump -l redo -x -a "dump fetch push restore clean"
complete -c aaa-db-dump -l stop-after -x -a "dump fetch push restore clean"
complete -c aaa-db-dump -l dry-run -d "print commands, execute nothing"
complete -c aaa-db-dump -l yes -d "confirm a destructive restore"
complete -c aaa-db-dump -l follow -d "tail progress"
complete -c aaa-db-dump -l no-follow -d "do not tail"
complete -c aaa-db-dump -l force-dump -d "dump despite a running pg_dump"
complete -c aaa-db-dump -l force-clean -d "clean despite a failed restore"
complete -c aaa-db-dump -n "__fish_seen_subcommand_from list" \
    -l aliases-only -l targets-only
"""

COMPLETION_BASH = r"""# aaa-db-dump completions for bash
# Regenerate with: aaa-db-dump completion bash
_aaa_db_dump() {
    local cur prev stages flags
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    stages="dump fetch push restore clean run status list completion"
    flags="--to --db --archive --dry-run --yes --follow --no-follow
           --force-dump --force-clean --redo --stop-after --aliases-only
           --targets-only --help"

    case "$prev" in
        --to)
            COMPREPLY=($(compgen -W "$(aaa-db-dump list --targets-only)" -- "$cur"))
            return ;;
        --archive)
            COMPREPLY=($(compgen -f -- "$cur"))
            return ;;
        --db)
            COMPREPLY=()
            return ;;
        --redo|--stop-after)
            COMPREPLY=($(compgen -W "dump fetch push restore clean" -- "$cur"))
            return ;;
        completion)
            COMPREPLY=($(compgen -W "fish bash zsh" -- "$cur"))
            return ;;
    esac

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "$flags" -- "$cur"))
        return
    fi
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$stages" -- "$cur"))
        return
    fi
    COMPREPLY=($(compgen -W "$(aaa-db-dump list --aliases-only)" -- "$cur"))
}
complete -F _aaa_db_dump aaa-db-dump
"""

COMPLETION_ZSH = r"""#compdef aaa-db-dump
# aaa-db-dump completions for zsh
# Regenerate with: aaa-db-dump completion zsh
_aaa_db_dump() {
    local state
    _arguments -C \
        '1:stage:(dump fetch push restore clean run status list completion)' \
        '--to[restore destination]:destination:->destinations' \
        '--db[database name inside the destination]:database:' \
        '--archive[a dump already on this machine; skips dump and fetch]:path:_files' \
        '--redo[re-run one stage]:stage:(dump fetch push restore clean)' \
        '--stop-after[stop after one stage]:stage:(dump fetch push restore clean)' \
        '--dry-run[print commands, execute nothing]' \
        '--yes[confirm a destructive restore]' \
        '--follow[tail progress]' \
        '--no-follow[do not tail]' \
        '--force-dump[dump despite a running pg_dump]' \
        '--force-clean[clean despite a failed restore]' \
        '--aliases-only[bare source alias names]' \
        '--targets-only[bare destination names]' \
        '*:alias:->aliases'

    case "$state" in
        destinations)
            _values 'destination' ${(f)"$(aaa-db-dump list --targets-only)"} ;;
        aliases)
            _values 'alias' ${(f)"$(aaa-db-dump list --aliases-only)"} ;;
    esac
}
_aaa_db_dump "$@"
"""

COMPLETIONS = {
    "fish": COMPLETION_FISH,
    "bash": COMPLETION_BASH,
    "zsh": COMPLETION_ZSH,
}


def cmd_completion(args, _cfg=None):
    sys.stdout.write(COMPLETIONS[args.shell])
    return 0


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("alias", help="source alias from databases.yaml")
    common.add_argument("--to", metavar="NAME",
                        help="restore destination (a key of restore_targets)")
    common.add_argument("--db", metavar="NAME",
                        help="database name inside the resolved destination; "
                             "cannot change host, container, or ssh hop")
    common.add_argument("--archive", metavar="PATH",
                        help="a dump already on this machine — a pg_dump "
                             "directory or a single dump file. push, restore "
                             "and run take it as their input, so no dump and "
                             "no fetch happen. Always re-verified before use")
    common.add_argument("--yes", action="store_true",
                        help="confirm the destructive restore")
    # Two separate gates, so one flag cannot silently disarm the other: a
    # --force meant for a stale pgrep match must not also let clean delete a
    # dump after a failed restore.
    common.add_argument("--force-dump", action="store_true",
                        help="start a dump despite a matching pg_dump process")
    common.add_argument("--force-clean", action="store_true",
                        help="delete from the bastion despite a failed restore")
    common.add_argument("--dry-run", action="store_true",
                        help="print every command, execute nothing")
    common.add_argument("--follow", dest="follow", action="store_true",
                        default=True, help="tail progress (default)")
    common.add_argument("--no-follow", dest="follow", action="store_false",
                        help="return immediately instead of tailing")

    parser = argparse.ArgumentParser(
        prog="aaa-db-dump",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(
        dest="command", required=True,
        metavar="{" + ",".join(SUBCOMMANDS) + "}")

    helps = {
        "dump": "run pg_dump on the bastion, detached",
        "fetch": "rsync the archive down and verify it",
        "push": "rsync the archive to the destination host",
        "restore": "recreate the database and pg_restore into it",
        "clean": "remove the archive and password-bearing script from the bastion",
    }
    for name in STAGES:
        sub.add_parser(name, parents=[common], help=helps[name])

    run_parser = sub.add_parser("run", parents=[common],
                                help="all five stages, gated and resumable")
    run_parser.add_argument("--redo", choices=STAGES, metavar="STAGE",
                            help="re-run a stage already marked complete")
    run_parser.add_argument("--stop-after", choices=STAGES, metavar="STAGE",
                            help="stop once this stage finishes")

    sub.add_parser("status", parents=[common],
                   help="where this alias is up to, re-checked live")

    list_parser = sub.add_parser("list", help="source aliases and destinations")
    list_parser.add_argument("--aliases-only", action="store_true",
                             help="bare postgres alias names, one per line")
    list_parser.add_argument("--targets-only", action="store_true",
                             help="bare restore destination names, one per line")

    completion_parser = sub.add_parser(
        "completion", help="print a completion script for fish, bash, or zsh")
    completion_parser.add_argument("shell", choices=["fish", "bash", "zsh"])

    return parser


def main():
    args = build_parser().parse_args()

    if args.command == "completion":
        return cmd_completion(args)

    cfg = load_config()

    if args.command == "list":
        return cmd_list(args, cfg)

    # --archive names a dump that already exists here, so the three stages that
    # make or delete one on the bastion have nothing to apply it to. Silently
    # ignoring it would let `run --archive` look like it had honoured the flag.
    if getattr(args, "archive", None) and args.command in ("dump", "fetch", "clean"):
        die(f"--archive has no meaning for {args.command}, which works on the "
            "bastion. Use it with push, restore, run, or status.")

    stop_after = getattr(args, "stop_after", None)
    if getattr(args, "archive", None) and stop_after in ("dump", "fetch"):
        die(f"--archive and --stop-after {stop_after} contradict each other: "
            "an archive you supplied means no dump and no fetch run at all.")

    # `run --stop-after dump` (or fetch) never reaches a destination, so
    # demanding one would block the commonest dump-only shape.
    dump_only = args.command == "run" and stop_after in ("dump", "fetch")
    if args.command in ("push", "restore", "run") and not args.to and not dump_only:
        legal = ", ".join(sorted(cfg.get("restore_targets") or {})) or "none"
        die(f"{args.command} needs --to NAME; legal destinations: {legal}\n"
            "  source aliases are dump sources only, never destinations")

    handlers = {
        "dump": cmd_dump,
        "fetch": cmd_fetch,
        "push": cmd_push,
        "restore": cmd_restore,
        "clean": cmd_clean,
        "run": cmd_run,
        "status": cmd_status,
    }
    return handlers[args.command](args, cfg)


if __name__ == "__main__":
    try:
        sys.exit(main() or 0)
    except KeyboardInterrupt:
        print("\ninterrupted. Work already detached on a bastion keeps running;")
        print("re-attach with: aaa-db-dump status <alias>")
        sys.exit(130)
