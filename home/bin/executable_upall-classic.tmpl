#!/usr/bin/env bash
# upall-classic — update everything, with per-step banners + full-size live logs.
# (v2 bash updater; superseded by the Go `upall` binary in ~/.local/bin.)
#
# Runs each tool's updater in order. Each step prints a banner (index, running
# glyph, and an overall progress line ✓✓▶·····) then streams its output at full
# terminal width/height — native scrollback stays intact, so scroll up any time.
# Every executed step is also tee'd to ~/.cache/upall/<ts>/ (newest 10 runs kept);
# on failure it offers the log in a pager and fires a desktop notification. A
# closing summary lists every step's result and elapsed time.
#
# Usage:
#   upall-classic                 Run every applicable step, in order.
#   upall-classic brew mise       Run only the named steps.
#   upall-classic --list          List step keys and labels.
#   upall-classic --plain         Force plain output (no color), still tees logs.
#   upall-classic -h | --help     Show this help.
#
# Env: UPALL_KEEP=N  retain N run-log dirs under ~/.cache/upall (default 10).
#
# Order: os → chezmoi → brew → mise → rust → uv → claude → ck → fisher → atuin.
# (v1 is preserved as `upall-v1`.)

set -uo pipefail

# ── Load shared engine ────────────────────────────────────────────────────────
LIB="$HOME/bin/lib/upall-lib.sh"
[ -f "$LIB" ] || LIB="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lib/upall-lib.sh"
# shellcheck source=/dev/null
. "$LIB" || { echo "upall-classic: cannot load $LIB" >&2; exit 3; }

set_title() { printf '\033]0;upall-classic: %s\007' "$1"; }
usage() { awk 'NR==1{next} /^[^#]/{exit} {sub(/^# ?/,"");print}' "$0"; }
die() { printf 'upall-classic: %s\n' "$*" >&2; exit 2; }

# ── Step implementations ──────────────────────────────────────────────────────
# Multi-command steps attempt every command and fail the step if any fails.
# shellcheck disable=SC2329  # step_* are dispatched indirectly via STEP_FNS[] (upall-lib.sh)
step_os()      { osupdate; }
step_nix()     { nix-config-update; }
step_chezmoi() { chezmoi update; }
step_brew()    { local rc=0; brew update || rc=1; brew upgrade || rc=1; brew cleanup || rc=1; return "$rc"; }
step_mise()    { mise up; }
step_rust()    { local rc=0; rustup self update || rc=1; rustup update || rc=1; cargo install-update -a || rc=1; return "$rc"; }
step_uv()      { uv tool upgrade --all; }
step_claude()  { if command -v claude >/dev/null 2>&1; then claude update; else "$HOME/.local/bin/claude" update; fi; }
step_ck()      { UPALL_ACTIVE=1 "$HOME/bin/ck-update"; }
step_fisher()  { fish -c "fisher update"; }
step_atuin()   { local rc=0; atuin history dedup --before "now" --dupkeep 1 || rc=1; atuin sync || rc=1; return "$rc"; }

{{ if eq .using_nix true -}}
KNOWN="os nix chezmoi brew mise rust uv claude ck fisher atuin"
{{- else -}}
KNOWN="os chezmoi brew mise rust uv claude ck fisher atuin"
{{- end }}

# ── Arg parsing ───────────────────────────────────────────────────────────────
SELECTED=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --list)    LIST=1; shift ;;
    --plain)   _UPALL_WANT_PLAIN=true; shift ;;
    -*)        die "unknown option: $1 (see --help)" ;;
    *)         SELECTED+=("$1"); shift ;;
  esac
done

# Validate any requested step keys against the known set.
if [ ${#SELECTED[@]} -gt 0 ]; then
  for k in "${SELECTED[@]}"; do
    case " $KNOWN " in *" $k "*) ;; *) die "unknown step: $k (known: $KNOWN)" ;; esac
  done
fi

# Register a step only when nothing was selected or its key was selected.
maybe() {
  local key="$1"
  if [ ${#SELECTED[@]} -eq 0 ]; then upall_register "$@"; return; fi
  local s; for s in "${SELECTED[@]}"; do [ "$s" = "$key" ] && { upall_register "$@"; return; }; done
}

# Guard snippets are stored literally and eval'd at check time, so $HOME must
# NOT expand here — single quotes are intentional.
# shellcheck disable=SC2016
upall_reset
maybe os      "OS Update"    "command -v osupdate"                                 step_os
{{ if eq .using_nix true -}}
maybe nix     "Nix Config"   '[ -d "$HOME/.config/nix-config" ]'                    step_nix
{{ end -}}
maybe chezmoi "Chezmoi"      "command -v chezmoi"                                   step_chezmoi
maybe brew    "Homebrew"     "command -v brew"                                      step_brew
maybe mise    "Mise"         "command -v mise"                                      step_mise
maybe rust    "Rust & Cargo" "command -v rustup"                                    step_rust
maybe uv      "uv Tools"     "command -v uv"                                        step_uv
maybe claude  "Claude CLI"   'command -v claude || [ -x "$HOME/.local/bin/claude" ]' step_claude
maybe ck      "ClaudeKit"    "command -v ck"                                        step_ck
maybe fisher  "Fisher"       'command -v fish && fish -c "functions -q fisher"'     step_fisher
maybe atuin   "Atuin"        "command -v atuin"                                     step_atuin

# ── --list ────────────────────────────────────────────────────────────────────
if [ "${LIST:-0}" = 1 ]; then
  [ ${#STEP_KEYS[@]} -gt 0 ] && for i in "${!STEP_KEYS[@]}"; do
    printf '  %-10s %s\n' "${STEP_KEYS[$i]}" "${STEP_LABELS[$i]}"
  done
  exit 0
fi

[ ${#STEP_KEYS[@]} -gt 0 ] || die "no matching steps to run"

# ── Prime sudo only when a sudo-needing step (OS Update) is in the run set ─────
# Prompt happens here, BEFORE the TUI starts (normal terminal, fully interactive).
# A background keep-alive then refreshes the sudo timestamp for the whole run so
# no password prompt ever interrupts the live TUI. It self-exits when upall does.
SUDO_KEEPALIVE=""
if [ -t 0 ] && printf '%s\n' "${STEP_KEYS[@]}" | grep -qx os; then
  sudo -v -p "Enter your sudo password: " || die "sudo is required for the OS Update step"
  ( while true; do sudo -n true 2>/dev/null; sleep 50; kill -0 "$$" 2>/dev/null || exit; done ) &
  SUDO_KEEPALIVE=$!
fi

# ── Run ───────────────────────────────────────────────────────────────────────
set_title "starting"
upall_begin "upall-classic"
upall_run_all
set_title "done"
upall_end "upall-classic"; rc=$?
[ -n "$SUDO_KEEPALIVE" ] && kill "$SUDO_KEEPALIVE" 2>/dev/null
exit "$rc"
