#!/usr/bin/env fish

function show_help
    echo "Usage: nix-config-update [OPTIONS]"
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message"
    echo "  --test        Use test configuration (appends -test to hostname)"
    echo
end

# Parse arguments
set -l test_mode false

for arg in $argv
    switch $arg
        case -h --help
            show_help
            exit 0
        case --test
            set test_mode true
        case "*"
            echo "Unknown option: $arg"
            show_help
            exit 1
    end
end

# Run darwin-rebuild with appropriate hostname suffix
set -l host_suffix ""
if test $test_mode = true
    set host_suffix -test
    echo -n "Using test configuration for host: "
    set_color green
    echo -n (hostname)
    set_color yellow
    echo " [TEST]"
    set_color normal
else
    echo -n "Using configuration for host: "
    set_color green
    echo (hostname)
    set_color normal
end

echo $host_suffix

# Set SSH command with reduced timeout (15 seconds)
set -x GIT_SSH_COMMAND "ssh -o ConnectTimeout=15 -o ServerAliveInterval=15"

echo
echo "Updating nix-config..."
cd ~/.config/nix-config

# Pull with rebase, accepting remote changes in case of conflicts
git pull --rebase -X theirs; or true

nix flake update

# Add all changes and commit only if there are changes
git add -A .
git diff --quiet --cached; or git commit -m "chore: update nix-config flake lock"

# Push changes if any were made
git push; or true

sudo darwin-rebuild switch --flake ~/.config/nix-config#(hostname)$host_suffix
nix profile upgrade --all
