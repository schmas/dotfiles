#!/usr/bin/env fish


# Set SSH command with reduced timeout (15 seconds)
set -x GIT_SSH_COMMAND "ssh -o ConnectTimeout=15 -o ServerAliveInterval=15"

echo
echo "Updating nix-config..."
cd ~/.config/nix-config

# Pull with rebase, accepting remote changes in case of conflicts
git pull --rebase -X theirs; or true

nix flake update

# Add all changes and commit only if there are changes
git add -A .
git diff --quiet --cached; or git commit -m "chore: update nix-config flake lock"

# Push changes if any were made
git push; or true

# Run darwin-rebuild
darwin-rebuild switch --flake ~/.config/nix-config#(hostname)
nix profile upgrade --all
