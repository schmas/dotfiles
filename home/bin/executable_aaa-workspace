#!/usr/bin/env bash
# AAA Connect+ Workspace Backup & Setup Script
# Usage: aaa-workspace [backup|setup]

set -euo pipefail

# Colors (disabled if not a terminal)
if [[ -t 1 ]]; then
  BOLD='\033[1m' DIM='\033[2m' GREEN='\033[32m' RED='\033[31m' YELLOW='\033[33m' CYAN='\033[36m' RESET='\033[0m'
else
  BOLD='' DIM='' GREEN='' RED='' YELLOW='' CYAN='' RESET=''
fi

AAA_DIR="$HOME/projects/work/aaa"
BACKUP_DIRS=(
  "$HOME/Documents/01.1_Projects/01_AAA_Connect+"
  "$HOME/ProtonDrive/00_Dev/01_AAA_Connect+"
)
BB_HOST="bitbucket-aaa"
BB_ORG="aaa-national"
REPOS=(connect-plus-backend connect-plus-frontend connectsuiteapps)

do_backup() {
  echo -e "${BOLD}=== AAA Workspace Backup ===${RESET}"
  echo ""

  # Validate sources
  for src in "$AAA_DIR/tools/data-integration" "$AAA_DIR/connect-plus-db"; do
    [[ ! -d "$src" ]] && { echo -e "${RED}⚠ Error: $src not found${RESET}"; exit 1; }
  done
  [[ ! -f "$AAA_DIR/mise.toml" ]] && { echo -e "${RED}⚠ Error: mise.toml not found${RESET}"; exit 1; }

  # Compress once to temp dir, then copy to all backup locations
  local tmp_dir
  tmp_dir="$(mktemp -d)"

  echo -e "${CYAN}--- Compressing ---${RESET}"
  echo -e "${DIM}Temp: $tmp_dir${RESET}"
  echo "  data-integration..."
  tar czf "$tmp_dir/data-integration.tar.gz" \
    -C "$AAA_DIR/tools" data-integration
  # Exclude dumps/ (large DB exports, regenerated locally)
  echo "  connect-plus-db (excluding dumps/)..."
  tar czf "$tmp_dir/connect-plus-db.tar.gz" \
    --exclude='dumps' \
    -C "$AAA_DIR" connect-plus-db
  echo "  git exclude files..."
  mkdir -p "$tmp_dir/git-excludes"
  for repo in "${REPOS[@]}"; do
    local exclude_file="$AAA_DIR/$repo/.git/info/exclude"
    if [[ -f "$exclude_file" ]]; then
      cp "$exclude_file" "$tmp_dir/git-excludes/$repo.exclude"
      echo -e "    ${GREEN}✓${RESET} $repo"
    else
      echo -e "    ${DIM}⚪ Skip (no exclude): $repo${RESET}"
    fi
  done
  if ls "$tmp_dir/git-excludes"/*.exclude &>/dev/null; then
    tar czf "$tmp_dir/git-excludes.tar.gz" -C "$tmp_dir" git-excludes
  fi

  echo ""
  echo -e "${CYAN}--- Copying to backup locations ---${RESET}"
  for backup_dir in "${BACKUP_DIRS[@]}"; do
    mkdir -p "$backup_dir"
    cp "$tmp_dir/data-integration.tar.gz" "$backup_dir/"
    cp "$tmp_dir/connect-plus-db.tar.gz" "$backup_dir/"
    cp "$AAA_DIR/mise.toml" "$backup_dir/mise.toml"
    [[ -f "$tmp_dir/git-excludes.tar.gz" ]] && cp "$tmp_dir/git-excludes.tar.gz" "$backup_dir/"
    echo -e "${GREEN}✓${RESET} $backup_dir"
  done

  rm -rf "$tmp_dir"
  echo -e "${DIM}✓ Temp cleaned: $tmp_dir${RESET}"

  echo ""
  echo -e "${CYAN}--- AI project settings ---${RESET}"
  claude-project-backup backup
}

do_setup() {
  echo -e "${BOLD}=== AAA Workspace Setup ===${RESET}"
  echo ""

  # Use first available backup dir as restore source
  local restore_dir=""
  for dir in "${BACKUP_DIRS[@]}"; do
    if [[ -d "$dir" ]]; then
      restore_dir="$dir"
      break
    fi
  done
  [[ -z "$restore_dir" ]] && { echo -e "${RED}⚠ Error: No backup directory found${RESET}"; exit 1; }

  # Validate backup files exist
  for f in data-integration.tar.gz connect-plus-db.tar.gz mise.toml; do
    [[ ! -f "$restore_dir/$f" ]] && { echo -e "${RED}⚠ Error: Missing backup file: $restore_dir/$f${RESET}"; exit 1; }
  done

  echo "Source: $restore_dir"
  echo "Target: $AAA_DIR"
  echo -e "${YELLOW}This will overwrite existing data.${RESET}"
  read -p "Continue? [y/N] " -n 1 -r
  echo ""
  [[ ! $REPLY =~ ^[Yy]$ ]] && { echo "Aborted."; exit 0; }

  echo ""
  echo -e "${CYAN}--- Cloning repos ---${RESET}"
  mkdir -p "$AAA_DIR/tools"
  for repo in "${REPOS[@]}"; do
    if [[ -d "$AAA_DIR/$repo" ]]; then
      echo -e "${DIM}⚪ Skip (exists): $repo${RESET}"
    else
      echo "  Cloning $repo..."
      if ! git clone "git@$BB_HOST:$BB_ORG/$repo.git" "$AAA_DIR/$repo"; then
        echo -e "${RED}⚠ Failed to clone $repo (check SSH keys for $BB_HOST)${RESET}"
        exit 1
      fi
    fi
  done

  echo ""
  echo -e "${CYAN}--- Restoring data ---${RESET}"
  echo "  Extracting data-integration..."
  tar xzf "$restore_dir/data-integration.tar.gz" -C "$AAA_DIR/tools"
  echo "  Extracting connect-plus-db..."
  tar xzf "$restore_dir/connect-plus-db.tar.gz" -C "$AAA_DIR"
  echo "  Copying mise.toml..."
  cp "$restore_dir/mise.toml" "$AAA_DIR/mise.toml"
  if [[ -f "$restore_dir/git-excludes.tar.gz" ]]; then
    echo "  Restoring git exclude files..."
    local ext_dir
    ext_dir="$(mktemp -d)"
    tar xzf "$restore_dir/git-excludes.tar.gz" -C "$ext_dir"
    for repo in "${REPOS[@]}"; do
      if [[ -f "$ext_dir/git-excludes/$repo.exclude" ]]; then
        mkdir -p "$AAA_DIR/$repo/.git/info"
        cp "$ext_dir/git-excludes/$repo.exclude" "$AAA_DIR/$repo/.git/info/exclude"
        echo -e "    ${GREEN}✓${RESET} $repo"
      fi
    done
    rm -rf "$ext_dir"
  fi

  echo ""
  echo -e "${CYAN}--- Installing tools ---${RESET}"
  (cd "$AAA_DIR" && mise install)

  echo ""
  echo -e "${CYAN}--- AI project settings ---${RESET}"
  claude-project-backup restore

  echo ""
  echo -e "${GREEN}✓ Setup complete.${RESET}"
}

case "${1:-}" in
  backup) do_backup ;;
  setup)  do_setup ;;
  *)
    echo "Usage: aaa-workspace [backup|setup]"
    echo "  backup  Compress & copy workspace data to backup locations"
    echo "  setup   Clone repos & restore data on a new machine"
    exit 1
    ;;
esac
