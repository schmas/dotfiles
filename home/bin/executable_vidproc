#!/usr/bin/env bash

set -e
set -u
set -o pipefail

# Defaults
SCALE=0.5
SPEED=2
CRF=28
OUTPUT=""
OVERWRITE=""

usage() {
    cat <<EOF
Usage: vidproc INPUT [OPTIONS]

Process video: resize, speed up, and compress using FFmpeg.

Options:
  -s, --scale FACTOR   Scale factor (default: 0.5 = 50%)
  -x, --speed MULT     Speed multiplier (default: 2)
  -q, --crf VALUE      Quality/compression 0-51 (default: 28, lower=better)
  -o, --output FILE    Output filename (default: INPUT_processed.mp4)
  -y                   Overwrite output without asking
  -h, --help           Show this help

Examples:
  vidproc video.mp4                  # 50% size, 2x speed, crf 28
  vidproc video.mp4 -s 0.25          # 25% size
  vidproc video.mp4 -x 4 -q 18       # 4x speed, high quality
  vidproc video.mp4 -o small.mp4    # Custom output name
EOF
    exit 0
}

die() {
    echo "Error: $1" >&2
    exit 1
}

# Build atempo filter chain for speeds outside 0.5-2.0 range
build_atempo() {
    local speed=$1
    local filter=""

    # Handle speeds > 2.0 by chaining atempo filters
    while (( $(echo "$speed > 2.0" | bc -l) )); do
        filter="${filter}atempo=2.0,"
        speed=$(echo "$speed / 2.0" | bc -l)
    done

    # Handle speeds < 0.5 by chaining atempo filters
    while (( $(echo "$speed < 0.5" | bc -l) )); do
        filter="${filter}atempo=0.5,"
        speed=$(echo "$speed / 0.5" | bc -l)
    done

    # Add final atempo for remaining speed
    filter="${filter}atempo=${speed}"
    echo "$filter"
}

# Parse arguments
INPUT=""
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help) usage ;;
        -s|--scale) SCALE="$2"; shift 2 ;;
        -x|--speed) SPEED="$2"; shift 2 ;;
        -q|--crf) CRF="$2"; shift 2 ;;
        -o|--output) OUTPUT="$2"; shift 2 ;;
        -y) OVERWRITE="-y"; shift ;;
        -*) die "Unknown option: $1" ;;
        *) INPUT="$1"; shift ;;
    esac
done

# Validate
[[ -z "$INPUT" ]] && die "No input file specified. Use -h for help."
[[ ! -f "$INPUT" ]] && die "Input file not found: $INPUT"
command -v ffmpeg &>/dev/null || die "FFmpeg not installed"

# Generate output filename if not specified
if [[ -z "$OUTPUT" ]]; then
    basename="${INPUT%.*}"
    OUTPUT="${basename}_processed.mp4"
fi

# Build filter chains
VIDEO_FILTER="scale=iw*${SCALE}:ih*${SCALE},setpts=PTS/${SPEED}"
AUDIO_FILTER=$(build_atempo "$SPEED")

echo "Processing: $INPUT"
echo "  Scale: ${SCALE}x, Speed: ${SPEED}x, CRF: $CRF"
echo "  Output: $OUTPUT"

ffmpeg $OVERWRITE -i "$INPUT" \
    -vf "$VIDEO_FILTER" \
    -af "$AUDIO_FILTER" \
    -c:v libx264 -crf "$CRF" -preset fast \
    -c:a aac \
    "$OUTPUT"

echo "Done: $OUTPUT"
