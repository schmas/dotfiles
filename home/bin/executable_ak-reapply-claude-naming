#!/usr/bin/env node
/**
 * Reapply custom AgentKit naming patch after `ak kit refresh` reinstalls hooks.
 *
 * `ak-update` runs `ak kit refresh engineer --global`, which overwrites
 * ~/.claude/hooks/**, wiping local edits. This script re-applies the one
 * customization AgentKit does not own, and is idempotent (safe to rerun):
 *
 *   context-builder.cjs: report filenames lead with the date for chronological
 *   sorting -> {date}[-{issue}]-{type}-{slug}.md (stock AgentKit puts {type}
 *   first). The plan date format is NOT handled here: it lives in
 *   ~/.agentkit/config.yaml (plan.date_format), which chezmoi owns and AgentKit
 *   reads natively. The legacy ~/.claude/.ck.json is ignored.
 *
 * Markers are matched with whitespace-tolerant regexes and the surrounding
 * indentation is reused, so upstream reformatting (kit 2.7.0 switched the hook
 * runtime from two-space to tab indentation) does not break the patch.
 */

const { execFileSync } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');

const HOME = os.homedir();
let failed = false;

const cbPath = path.join(HOME, '.claude/hooks/lib/context-builder.cjs');

// Match the function signature plus the indentation of its first statement, so
// the injected lines adopt whatever indent style the current kit ships.
const SIG_RE =
  /(function buildNamingSection\(\{ reportsPath, plansPath, namePattern \}\) \{\r?\n)([ \t]*)(return \[)/;

// The report filename template: move {type} from the front to after the date.
const REPORT_RE = /\{type\}-\$\{namePattern\}\.md/;

try {
  const original = fs.readFileSync(cbPath, 'utf8');

  if (original.includes('const reportPattern =')) {
    console.log('  context-builder.cjs: already patched');
  } else {
    if (!SIG_RE.test(original)) {
      throw new Error('buildNamingSection signature marker not found');
    }
    if (!REPORT_RE.test(original)) {
      throw new Error('report filename marker "{type}-${namePattern}.md" not found');
    }

    // Function replacers keep `$` and `{` in the replacement text literal.
    const patched = original
      .replace(SIG_RE, (_m, head, indent, ret) =>
        head +
        `${indent}// Reports lead with the date prefix for chronological sorting: {date}[-{issue}]-{type}-{slug}.\n` +
        `${indent}const reportPattern = namePattern.replace(/\\{slug\\}$/, '{type}-{slug}');\n` +
        `${indent}${ret}`)
      .replace(REPORT_RE, () => '${reportPattern}.md');

    // Never leave a syntactically broken hook runtime behind: validate the
    // patched source in a temp file and only then swap it in.
    // Keep the .cjs extension: `node --check` rejects unknown extensions.
    const tmpPath = cbPath.replace(/\.cjs$/, '.patch-check.cjs');
    try {
      fs.writeFileSync(tmpPath, patched);
      execFileSync(process.execPath, ['--check', tmpPath], { stdio: 'pipe' });
    } catch (checkErr) {
      throw new Error(`patched source failed node --check: ${checkErr.message}`);
    } finally {
      fs.rmSync(tmpPath, { force: true });
    }

    fs.writeFileSync(cbPath, patched);
    console.log('  context-builder.cjs: patched (date-first reports)');
  }
} catch (err) {
  console.error('  context-builder.cjs: FAILED -', err.message);
  failed = true;
}

process.exit(failed ? 1 : 0);
