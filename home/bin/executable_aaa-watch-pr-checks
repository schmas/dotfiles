#!/usr/bin/env bash
# aaa-watch-pr-checks — Watch a Bitbucket PR's CI/build checks and notify on finish.
#
# Wraps `bkt pr checks <id> --wait` (polls with backoff until all builds finish)
# and, while it waits, renders a LIVE step-by-step view of each pipeline: what's
# done ✓, failed ✗, running ▶, or pending ·. Fires a macOS notification on the
# outcome — useful for long pipelines (~20 min) you don't want to babysit.
# Notifies on BOTH success and failure.
#
# Usage:
#   aaa-watch-pr-checks [PR_ID] [options]
#
# Examples:
#   aaa-watch-pr-checks              # PR for the current git branch
#   aaa-watch-pr-checks 3636         # explicit PR id
#   aaa-watch-pr-checks --timeout 1h --fail-fast
#   aaa-watch-pr-checks 3636 --interval 1m --no-sound
#
# Options:
#   --timeout <dur>    Max time to wait (default 45m). 0 = no timeout.
#   --interval <dur>   Poll interval (default 30s; backs off to 2m). Also sets the
#                      live-view refresh cadence (clamped to 5-20s).
#   --fail-fast        Stop and notify on the first failed check.
#   --no-sound         Silent notification.
#   --icon <path|url>  Notification icon (default: Bitbucket logo).
#                      Override the default with $AAA_PR_NOTIFY_ICON.
#   --no-icon          Use terminal-notifier's default icon.
#   -h, --help         Show this help.
#
# Exit codes (mirrors `bkt pr checks --wait`):
#   0  all checks passed
#   1  a check failed
#   8  timed out with checks still pending
#   2  usage / preflight error
#
# Requires: bkt (Bitbucket CLI, authed), jq. Notifies via terminal-notifier
# (clickable → opens the PR, custom icon, per-outcome sound), falling back to
# osascript (sound only — osascript can't set a custom icon). Run from inside
# the Bitbucket repo so `bkt` infers workspace/repo from the git remote.
# The live step view is Bitbucket Cloud only (uses `bkt pipeline view`); on Data
# Center it degrades to the top-level check list.

set -uo pipefail

# ── Defaults ────────────────────────────────────────────────────────────────
PR_ID=""
TIMEOUT="45m"
INTERVAL="30s"
FAIL_FAST=false
SOUND=true
# Notification icon: env override wins, else official Bitbucket logo (terminal-notifier
# downloads + caches it; if unreachable it silently falls back to its default icon).
ICON="${AAA_PR_NOTIFY_ICON:-https://wac-cdn.atlassian.com/assets/img/favicons/bitbucket/android-chrome-192x192.png}"

# Print the leading comment block (the header above) as help, minus the shebang.
usage() { awk 'NR==1{next} /^[^#]/{exit} {sub(/^# ?/,"");print}' "$0"; }

die() { printf 'error: %s\n' "$*" >&2; exit 2; }

# ── Arg parsing ─────────────────────────────────────────────────────────────
while [ $# -gt 0 ]; do
  case "$1" in
    --timeout)   TIMEOUT="${2:-}"; shift 2 ;;
    --interval)  INTERVAL="${2:-}"; shift 2 ;;
    --fail-fast) FAIL_FAST=true; shift ;;
    --no-sound)  SOUND=false; shift ;;
    --icon)      ICON="${2:-}"; shift 2 ;;
    --no-icon)   ICON=""; shift ;;
    -h|--help)   usage; exit 0 ;;
    -*)          die "unknown option: $1 (see --help)" ;;
    *)
      [ -z "$PR_ID" ] || die "unexpected argument: $1"
      PR_ID="$1"; shift ;;
  esac
done

# ── Preflight ───────────────────────────────────────────────────────────────
command -v bkt >/dev/null 2>&1 || die "bkt not found (Bitbucket CLI). Install and run 'bkt auth login'."
command -v jq  >/dev/null 2>&1 || die "jq not found."

# ── Resolve PR id from the current branch when not given ────────────────────
if [ -z "$PR_ID" ]; then
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) \
    || die "not in a git repo; pass a PR id: aaa-watch-pr-checks <id>"

  pr_json=$(bkt pr list --json 2>/dev/null) \
    || die "could not list PRs (check 'bkt auth status' and run inside the Bitbucket repo)."

  PR_ID=$(printf '%s' "$pr_json" \
    | jq -r --arg b "$branch" \
        'first((.pull_requests // [])[] | select(.source.branch.name == $b) | .id) // empty')

  [ -n "$PR_ID" ] || die "no open PR found for branch '$branch'. Pass a PR id: aaa-watch-pr-checks <id>"
  printf 'Auto-detected PR #%s for branch %s\n' "$PR_ID" "$branch"
fi

# ── PR web URL (for a clickable notification) ───────────────────────────────
PR_URL=$(bkt pr view "$PR_ID" --json 2>/dev/null \
  | jq -r --arg id "$PR_ID" \
      '[.. | objects | .href? // empty] | map(select(endswith("/pull-requests/" + $id))) | first // empty')

# ── notify <title> <message> <sound-name> ───────────────────────────────────
notify() {
  local title="$1" message="$2" sound_name="$3"
  if command -v terminal-notifier >/dev/null 2>&1; then
    local args=(-title "$title" -message "$message" -group "aaa-pr-checks-$PR_ID")
    [ "$SOUND" = true ] && args+=(-sound "$sound_name")
    [ -n "$ICON" ] && args+=(-appIcon "$ICON")
    [ -n "$PR_URL" ] && args+=(-open "$PR_URL")
    terminal-notifier "${args[@]}" >/dev/null 2>&1
  elif command -v osascript >/dev/null 2>&1; then
    local script="display notification \"${message//\"/\\\"}\" with title \"${title//\"/\\\"}\""
    [ "$SOUND" = true ] && script="$script sound name \"$sound_name\""
    osascript -e "$script" >/dev/null 2>&1
  fi
}

# ── Live-view helpers ────────────────────────────────────────────────────────
# Colors + glyphs only when stdout is a TTY (piped/CI output stays plain).
if [ -t 1 ]; then TTY=true; else TTY=false; fi
if [ "$TTY" = true ]; then
  C_RST=$'\033[0m'; C_GRN=$'\033[32m'; C_RED=$'\033[31m'
  C_YEL=$'\033[33m'; C_DIM=$'\033[2m';  C_BLU=$'\033[1;34m'
else
  C_RST=""; C_GRN=""; C_RED=""; C_YEL=""; C_DIM=""; C_BLU=""
fi

# Duration string ("30s", "2m", "1h", or bare seconds) → seconds.
to_seconds() {
  case "$1" in
    *h) printf '%d' $(( ${1%h} * 3600 )) ;;
    *m) printf '%d' $(( ${1%m} * 60 )) ;;
    *s) printf '%d' "${1%s}" ;;
    *)  printf '%d' "$1" ;;
  esac
}

# Seconds → "Mm SSs".
fmt_dur() { printf '%dm%02ds' $(( $1 / 60 )) $(( $1 % 60 )); }

# State name → colored status glyph. Handles both build-status states
# (SUCCESSFUL/FAILED/INPROGRESS/STOPPED) and pipeline-step states
# (COMPLETED-resolved-to-result, IN_PROGRESS, PENDING, …).
cglyph() {
  case "$1" in
    SUCCESSFUL)                     printf '%s✓%s' "$C_GRN" "$C_RST" ;;
    FAILED|ERROR)                   printf '%s✗%s' "$C_RED" "$C_RST" ;;
    STOPPED)                        printf '%s■%s' "$C_RED" "$C_RST" ;;
    INPROGRESS|IN_PROGRESS|RUNNING) printf '%s▶%s' "$C_YEL" "$C_RST" ;;
    PENDING|NOT_RUN|PAUSED|HALTED)  printf '%s·%s' "$C_DIM" "$C_RST" ;;
    *)                              printf '?' ;;
  esac
}

# Bitbucket Cloud pipeline URL → "workspace repo build_number" (empty if not one).
pipeline_coords() {
  printf '%s' "$1" \
    | sed -nE 's#^https?://bitbucket\.org/([^/]+)/([^/]+)/pipelines/results/([0-9]+).*#\1 \2 \3#p'
}

# checks-JSON → coords ("ws repo build") of the latest pipeline (highest build),
# or empty when no pipeline is attached. Reused by render + final summary.
latest_pipeline_coords() {
  printf '%s' "$1" | jq -r '.statuses[]?.url // empty' | while read -r u; do
    c=$(pipeline_coords "$u"); [ -n "$c" ] && printf '%s\n' "$c"
  done | sort -k3 -n | tail -1
}

# checks-JSON → build number of the latest pipeline (empty when none).
latest_pipeline_build() {
  local c; c=$(latest_pipeline_coords "$1"); [ -n "$c" ] && { read -r _ _ b <<< "$c"; printf '%s' "$b"; }
}

# Render the current status block to stdout: every top-level check, and for each
# check that points at a pipeline, the per-step breakdown indented beneath it.
render_block() {
  local checks state name url coords ws repo build pv steps ok bad run total tail latest

  printf '%sPR #%s%s  %s elapsed  (refresh %ss, Ctrl-C to stop)\n' \
    "$C_BLU" "$PR_ID" "$C_RST" "$(fmt_dur "$SECONDS")" "$RENDER_EVERY"

  checks=$(bkt pr checks "$PR_ID" --json 2>/dev/null)
  # When several pipeline runs are attached (re-runs), only expand the latest
  # (highest build number); older ones collapse to a one-liner.
  latest=$(latest_pipeline_build "$checks")
  while IFS=$'\t' read -r state name url; do
    [ -n "$name" ] || continue
    coords=$(pipeline_coords "$url")
    if [ -n "$coords" ]; then
      read -r ws repo build <<< "$coords"
      if [ -n "$latest" ] && [ "$build" != "$latest" ]; then
        printf '%s %s  #%s  [%s] %s(superseded)%s\n' \
          "$(cglyph "$state")" "$name" "$build" "$state" "$C_DIM" "$C_RST"
        continue
      fi
      pv=$(bkt pipeline view "$build" --workspace "$ws" --repo "$repo" --json 2>/dev/null)
      read -r ok bad run total <<< "$(printf '%s' "$pv" | jq -r '
        [.steps[]?] as $s
        | ([$s[] | select(.state.name=="COMPLETED" and .result.name=="SUCCESSFUL")] | length) as $ok
        | ([$s[] | select(.state.name=="COMPLETED" and (.result.name|IN("FAILED","ERROR","STOPPED")))] | length) as $bad
        | ([$s[] | select(.state.name=="IN_PROGRESS")] | length) as $run
        | "\($ok) \($bad) \($run) \($s|length)"' 2>/dev/null)"
      : "${ok:=0}" "${bad:=0}" "${run:=0}" "${total:=0}"
      tail="${ok}/${total} done"
      [ "$run" -gt 0 ] && tail="$tail, $run running"
      [ "$bad" -gt 0 ] && tail="$tail, ${C_RED}${bad} failed${C_RST}"
      printf '%s %s  #%s  %s\n' "$(cglyph "$state")" "$name" "$build" "$tail"
      steps=$(printf '%s' "$pv" | jq -r '
        .steps[]?
        | (if .state.name=="COMPLETED" then .result.name else .state.name end) as $st
        | [$st, .name] | @tsv' 2>/dev/null)
      while IFS=$'\t' read -r st sname; do
        [ -n "$sname" ] || continue
        printf '    %s %s\n' "$(cglyph "$st")" "$sname"
      done <<< "$steps"
    else
      printf '%s %s  [%s]\n' "$(cglyph "$state")" "$name" "$state"
    fi
  done < <(printf '%s' "$checks" | jq -r '.statuses[]? | [.state, .name, .url] | @tsv' 2>/dev/null)
}

# ── Restore terminal state on exit / interrupt ───────────────────────────────
waiter=""
cleanup() {
  [ "$TTY" = true ] && printf '\033[?25h'          # show cursor
  [ -n "$waiter" ] && kill "$waiter" 2>/dev/null || true
}
trap 'exit 130' INT TERM
trap cleanup EXIT

# ── Watch: bkt owns the authoritative wait; we render the live step view ─────
printf 'Watching checks for PR #%s (timeout %s, poll %s)...\n' "$PR_ID" "$TIMEOUT" "$INTERVAL"
[ -n "$PR_URL" ] && printf '%s\n' "$PR_URL"

RENDER_EVERY=$(to_seconds "$INTERVAL")
[ "$RENDER_EVERY" -lt 5 ]  && RENDER_EVERY=5
[ "$RENDER_EVERY" -gt 20 ] && RENDER_EVERY=20

wait_args=(pr checks "$PR_ID" --wait --timeout "$TIMEOUT" --interval "$INTERVAL")
[ "$FAIL_FAST" = true ] && wait_args+=(--fail-fast)
bkt "${wait_args[@]}" >/dev/null 2>&1 &
waiter=$!

[ "$TTY" = true ] && printf '\033[?25l'            # hide cursor during redraws
prev_lines=0
first=true
while kill -0 "$waiter" 2>/dev/null; do
  block=$(render_block)
  n=$(printf '%s\n' "$block" | wc -l | tr -d ' ')
  if [ "$TTY" = true ]; then
    [ "$first" = false ] && printf '\033[%dA\033[J' "$prev_lines"   # redraw in place
  else
    [ "$first" = false ] && printf '\n'                              # append snapshots
  fi
  printf '%s\n' "$block"
  prev_lines=$n
  first=false
  # Sleep the refresh interval, but wake early when the waiter finishes.
  slept=0
  while [ "$slept" -lt "$RENDER_EVERY" ]; do
    kill -0 "$waiter" 2>/dev/null || break
    sleep 1; slept=$((slept + 1))
  done
done
wait "$waiter"; rc=$?

# Final redraw so the terminal shows the fully-resolved state.
block=$(render_block)
if [ "$TTY" = true ]; then
  [ "$first" = false ] && printf '\033[%dA\033[J' "$prev_lines"
else
  [ "$first" = false ] && printf '\n'
fi
printf '%s\n' "$block"

# ── Summarize outcome from the final statuses ───────────────────────────────
checks_json=$(bkt pr checks "$PR_ID" --json 2>/dev/null)
summary=$(printf '%s' "$checks_json" | jq -r '
  (.statuses // []) as $s
  | ($s | length) as $total
  | ([$s[] | select(.state == "SUCCESSFUL")] | length) as $ok
  | ([$s[] | select(.state == "INPROGRESS")] | length) as $pending
  | ([$s[] | select(.state == "FAILED" or .state == "STOPPED")]) as $bad
  | "\($total)\t\($ok)\t\($pending)\t\($bad | length)\t\([$bad[].name] | join(", "))"
')
IFS=$'\t' read -r total ok pending nfailed failed_names <<< "${summary:-0	0	0	0	}"

# Prefer failed *step* names (more actionable) over the coarse "Pipeline ..." name.
# Only the latest pipeline run matters for the outcome.
failed_steps=""
latest_coords=$(latest_pipeline_coords "$checks_json")
if [ -n "$latest_coords" ]; then
  read -r ws repo build <<< "$latest_coords"
  failed_steps=$(bkt pipeline view "$build" --workspace "$ws" --repo "$repo" --json 2>/dev/null | jq -r '
    .steps[]? | select(.state.name=="COMPLETED" and (.result.name|IN("FAILED","ERROR","STOPPED"))) | .name' \
    | paste -sd', ' -)
fi
failed_detail="${failed_steps:-$failed_names}"

# ── Notify + report based on exit code ──────────────────────────────────────
case "$rc" in
  0)
    title="✅ PR #$PR_ID — checks passed"
    msg="${ok}/${total} builds OK"
    notify "$title" "$msg" "Glass" ;;
  1)
    title="❌ PR #$PR_ID — checks FAILED"
    msg="${nfailed}/${total} failed"
    [ -n "$failed_detail" ] && msg="$msg: $failed_detail"
    notify "$title" "$msg" "Basso" ;;
  8)
    title="⏳ PR #$PR_ID — still pending"
    msg="Timed out after $TIMEOUT; $pending still running"
    notify "$title" "$msg" "Funk" ;;
  *)
    title="⚠️ PR #$PR_ID — watch error"
    msg="bkt exited $rc"
    notify "$title" "$msg" "Funk" ;;
esac

printf '\n%s\n%s\n' "$title" "$msg"
exit "$rc"
