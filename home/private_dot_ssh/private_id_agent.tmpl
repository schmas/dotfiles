{{- /*
  Per-machine agent key, written as a plain file so ssh and git signing use it
  without a 1Password approval prompt. Scope: the agent_config hosts only.
  Do not export other keys this way from this repo.
*/ -}}
{{- $item := includeTemplate "agent-key-item" . | trim -}}
{{- if $item -}}
{{ onepasswordRead (printf "op://Agent/%s/private key?ssh-format=openssh" $item) | trim }}
{{ end -}}
